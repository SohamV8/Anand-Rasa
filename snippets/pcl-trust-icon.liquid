{%- comment -%}
  Premium collections — trust bar icons (theme asset images)
  @param icon {string} made-in-india | cruelty-free | secure-payments | worldwide-shipping
{%- endcomment -%}
{%- liquid
  assign icon_file = ''
  case icon
    when 'made-in-india'
      assign icon_file = 'icon-made-in-india.webp'
    when 'cruelty-free'
      assign icon_file = 'icon-cruelty-free.webp'
    when 'secure-payments'
      assign icon_file = 'icon-secure-payments.webp'
    when 'worldwide-shipping'
      assign icon_file = 'icon-worldwide-shipping.webp'
  endcase
-%}
{%- if icon_file != blank -%}
  <img
    src="{{ icon_file | asset_url }}"
    alt=""
    width="72"
    height="72"
    loading="lazy"
    decoding="async"
  >
{%- endif -%}
