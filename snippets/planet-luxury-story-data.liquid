{%- comment -%}
  Planet luxury story data — echoes one pipe-delimited payload for the parent snippet.
  Format: key|||name|||heading|||desc|||cta1|||cta2|||image|||icon|||b1t|||b1d|||b2t|||b2d|||b3t|||b3d|||b4t|||b4d
{%- endcomment -%}
{%- liquid
  assign pls_p = product
  if pls_p == blank
    assign pls_p = pls_product
  endif

  assign pls_key = blank
  assign pls_scope = pls_p.handle | append: '|' | append: pls_p.title | append: '|' | append: pls_p.type | downcase
  assign pls_tags = pls_p.tags | join: '|' | downcase
  assign pls_cols = pls_p.collections | map: 'handle' | join: '|' | downcase
  assign pls_all = pls_scope | append: '|' | append: pls_tags | append: '|' | append: pls_cols

  if pls_all contains 'surya' or pls_all contains 'sun'
    assign pls_key = 'surya'
  elsif pls_all contains 'chandra' or pls_all contains 'moon'
    assign pls_key = 'chandra'
  elsif pls_all contains 'mangal' or pls_all contains 'mars'
    assign pls_key = 'mangal'
  elsif pls_all contains 'budh' or pls_all contains 'budha' or pls_all contains 'mercury'
    assign pls_key = 'budha'
  elsif pls_all contains 'guru' or pls_all contains 'jupiter'
    assign pls_key = 'guru'
  elsif pls_all contains 'shukra' or pls_all contains 'venus'
    assign pls_key = 'shukra'
  elsif pls_all contains 'shani' or pls_all contains 'saturn'
    assign pls_key = 'shani'
  elsif pls_all contains 'rahu'
    assign pls_key = 'rahu'
  elsif pls_all contains 'ketu'
    assign pls_key = 'ketu'
  endif

  assign n = pls_p.title
  assign h = pls_p.title
  assign d = pls_p.description | strip_html | truncate: 220
  assign c1 = 'Discover'
  assign c2 = 'Explore the Collection'
  assign img = blank
  assign icn = blank
  assign t1 = blank
  assign d1 = blank
  assign t2 = blank
  assign d2 = blank
  assign t3 = blank
  assign d3 = blank
  assign t4 = blank
  assign d4 = blank

  case pls_key
    when 'surya'
      assign n = 'Surya Attar'
      assign h = 'Surya — The Solar Attar of Leadership'
      assign d = 'Crafted for confidence, leadership and everyday radiance. An alcohol-free solar attar that wears close to the skin and unfolds through the day.'
      assign c1 = 'Discover Surya'
      assign c2 = 'Experience Solar Energy'
      assign img = 'planet-attar-surya.webp'
      assign icn = 'Planet-sun.webp'
      assign t1 = 'Confidence & Leadership'
      assign d1 = 'Surya is the planet of confidence, leadership and energy. Perfect for people who want to feel more confident and take charge in daily life.'
      assign t2 = 'Long-Lasting Fragrance'
      assign d2 = 'Made with pure botanical oils. Alcohol-free and gentle on skin. Slowly develops through the day for a rich, lasting fragrance.'
      assign t3 = 'Inspired by the Sun'
      assign d3 = 'Inspired by Surya, the planet of confidence and success in Vedic astrology. Wear it as part of your morning routine.'
      assign t4 = 'Saffron, Sandalwood & Amber'
      assign d4 = 'Made with saffron, Mysore sandalwood and warm amber. Simple, natural ingredients chosen to match the energy of the Sun.'
