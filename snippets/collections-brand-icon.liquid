{%- comment -%}
  Collections brand strip / premium feature icons — theme asset images
  @param icon {string} pure-oil | alcohol-free | handcrafted | astrology | long-lasting | distillation
{%- endcomment -%}
{%- liquid
  assign icon_file = ''
  case icon
    when 'pure-oil'
      assign icon_file = 'icon-pure-oil.webp'
    when 'alcohol-free'
      assign icon_file = 'icon-alcohol-free.webp'
    when 'handcrafted'
      assign icon_file = 'icon-handcrafted.webp'
    when 'astrology'
      assign icon_file = 'icon-astrology-inspired.webp'
    when 'long-lasting'
      assign icon_file = 'icon-long-lasting.webp'
    when 'distillation'
      assign icon_file = 'icon-traditional-distillation.webp'
  endcase
-%}
{%- if icon_file != blank -%}
  <img
    src="{{ icon_file | asset_url }}"
    alt=""
    width="72"
    height="72"
    loading="lazy"
    decoding="async"
  >
{%- endif -%}
