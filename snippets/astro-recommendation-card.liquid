{%- comment -%}
  Modern recommendation product card (AFR carousel).
  Accepts: card_product, card_index, section_id, subtitle_override
{%- endcomment -%}

{%- liquid
  assign ar_key = card_product.handle | append: ' ' | append: card_product.title | append: ' ' | append: card_product.type | downcase
  assign ar_tags = card_product.tags | join: ' ' | downcase
  assign ar_scope = ar_key | append: ' ' | append: ar_tags

  assign ar_type_key = card_product.type | downcase | strip
  assign ar_subtitle = 'Attar'

  if ar_type_key contains 'incense' or ar_type_key contains 'agarbatti' or ar_type_key contains 'dhoop'
    assign ar_subtitle = 'Incense Stick'
  elsif ar_type_key contains 'gift'
    assign ar_subtitle = 'Gift Set'
  elsif ar_type_key contains 'perfume'
    assign ar_subtitle = 'Perfume'
  elsif ar_type_key contains 'gourmand'
    assign ar_subtitle = 'Gourmand'
  elsif ar_type_key contains 'stress'
    assign ar_subtitle = 'Stress Relief'
  elsif ar_type_key contains 'love'
    assign ar_subtitle = 'Prem Rasa'
  elsif ar_type_key contains 'astrology' or ar_type_key == ''
    assign ar_subtitle = 'Attar'
  elsif card_product.type != blank
    assign ar_subtitle = card_product.type | strip
  endif

  assign ar_is_bestseller = false
  if card_product.tags contains 'bestseller' or card_product.tags contains 'Bestseller'
    assign ar_is_bestseller = true
  endif
  for c in card_product.collections
    assign ar_col_key = c.handle | downcase
    if ar_col_key contains 'bestseller' or ar_col_key contains 'best-seller'
      assign ar_is_bestseller = true
      break
    endif
  endfor

  if ar_is_bestseller
    unless ar_type_key contains 'incense' or ar_type_key contains 'agarbatti' or ar_type_key contains 'perfume' or ar_type_key contains 'gift' or ar_type_key contains 'gourmand'
      assign ar_subtitle = 'Attar'
    endunless
  endif

  assign ar_bg = ''
  assign ar_img = card_product.featured_image
  assign ar_showcase_asset = ''
  assign ar_img_fallback = ''

  if ar_scope contains 'surya' or ar_scope contains 'sun'
    assign ar_subtitle = 'Sun Attar'
    assign ar_bg = 'Planet-sun.webp'
    assign ar_showcase_asset = 'planet-attar-surya.webp'
    if ar_img == blank
      assign ar_img_fallback = 'planet-attar-surya.webp'
    endif
  elsif ar_scope contains 'chandra' or ar_scope contains 'moon'
    assign ar_subtitle = 'Moon Attar'
    assign ar_bg = 'Planet-moon.webp'
    assign ar_showcase_asset = 'planet-attar-chandra.webp'
    if ar_img == blank
      assign ar_img_fallback = 'planet-attar-chandra.webp'
    endif
  elsif ar_scope contains 'mangal' or ar_scope contains 'mars'
    assign ar_subtitle = 'Mars Attar'
    assign ar_bg = 'Planet-mars.webp'
    assign ar_showcase_asset = 'planet-attar-mangal.webp'
  elsif ar_scope contains 'budh' or ar_scope contains 'mercury'
    assign ar_subtitle = 'Mercury Attar'
    assign ar_bg = 'Planet-Mercury.webp'
    assign ar_showcase_asset = 'planet-attar-budh.webp'
  elsif ar_scope contains 'guru' or ar_scope contains 'jupiter'
    assign ar_subtitle = 'Jupiter Attar'
    assign ar_bg = 'Planet-Jupiter.webp'
    assign ar_showcase_asset = 'planet-attar-guru.webp'
  elsif ar_scope contains 'shukra' or ar_scope contains 'venus'
    assign ar_subtitle = 'Venus Attar'
    assign ar_bg = 'Planet-Venus.webp'
    assign ar_showcase_asset = 'planet-attar-shukra.webp'
  elsif ar_scope contains 'shani' or ar_scope contains 'saturn'
    assign ar_subtitle = 'Saturn Attar'
    assign ar_bg = 'Planet-Saturn.webp'
    assign ar_showcase_asset = 'planet-attar-shani.webp'
  elsif ar_scope contains 'rahu'
    assign ar_subtitle = 'Rahu Attar'
    assign ar_bg = 'Planet-Rahu.webp'
    assign ar_showcase_asset = 'planet-attar-rahu.webp'
  elsif ar_scope contains 'ketu'
    assign ar_subtitle = 'Ketu Attar'
    assign ar_bg = 'Planet-Ketu.webp'
    assign ar_showcase_asset = 'planet-attar-ketu.webp'
  elsif ar_scope contains 'chakra' or ar_scope contains 'muladhara' or ar_scope contains 'svadhisthana' or ar_scope contains 'swadhisthana' or ar_scope contains 'manipura' or ar_scope contains 'anahata' or ar_scope contains 'vishuddha' or ar_scope contains 'vishudha' or ar_scope contains 'ajna' or ar_scope contains 'agya' or ar_scope contains 'sahasrara' or ar_scope contains 'root-chakra' or ar_scope contains 'sacral-chakra' or ar_scope contains 'heart-chakra' or ar_scope contains 'throat-chakra' or ar_scope contains 'third-eye' or ar_scope contains 'crown-chakra'
    assign ar_subtitle = 'Chakra Attar'
  elsif ar_scope contains 'nakshatra' or ar_scope contains 'rohini' or ar_scope contains 'ashwini' or ar_scope contains 'bharani' or ar_scope contains 'kritika' or ar_scope contains 'mrigashira' or ar_scope contains 'ardra' or ar_scope contains 'punarvasu' or ar_scope contains 'pushya' or ar_scope contains 'ashlesha' or ar_scope contains 'magha' or ar_scope contains 'phalguni' or ar_scope contains 'hasta' or ar_scope contains 'chitra' or ar_scope contains 'swati' or ar_scope contains 'vishakha' or ar_scope contains 'anuradha' or ar_scope contains 'jyeshtha' or ar_scope contains 'ashadha' or ar_scope contains 'shravana' or ar_scope contains 'dhanishtha' or ar_scope contains 'shatabhisha' or ar_scope contains 'bhadrapada' or ar_scope contains 'revati' or ar_scope contains 'nakshatra-mula' or ar_scope contains 'mula-attar' or ar_scope contains 'mula attar' or ar_scope contains 'mula nakshatra'
    assign ar_subtitle = 'Nakshatra Attar'
    if ar_scope contains 'rohini'
      assign ar_bg = 'Nakshatra-Rohini.webp'
    endif
  elsif ar_scope contains 'zodiac' or ar_scope contains 'aries' or ar_scope contains 'taurus' or ar_scope contains 'gemini' or ar_scope contains 'cancer' or ar_scope contains 'leo' or ar_scope contains 'virgo' or ar_scope contains 'libra' or ar_scope contains 'scorpio' or ar_scope contains 'sagittarius' or ar_scope contains 'capricorn' or ar_scope contains 'aquarius' or ar_scope contains 'pisces'
    assign ar_subtitle = 'Zodiac Attar'
    if ar_scope contains 'scorpio'
      assign ar_bg = 'zodiac-attar-scorpio.webp'
    elsif ar_scope contains 'aries'
      assign ar_bg = 'zodiac-attar-aries.webp'
    elsif ar_scope contains 'taurus'
      assign ar_bg = 'zodiac-attar-taurus.webp'
    elsif ar_scope contains 'gemini'
      assign ar_bg = 'zodiac-attar-gemini.webp'
    elsif ar_scope contains 'cancer'
      assign ar_bg = 'zodiac-attar-cancer.webp'
    elsif ar_scope contains 'leo'
      assign ar_bg = 'zodiac-attar-leo.webp'
    elsif ar_scope contains 'virgo'
      assign ar_bg = 'zodiac-attar-virgo.webp'
    elsif ar_scope contains 'libra'
      assign ar_bg = 'zodiac-attar-libra.webp'
    elsif ar_scope contains 'sagittarius'
      assign ar_bg = 'zodiac-attar-sagittarius.webp'
    elsif ar_scope contains 'capricorn'
      assign ar_bg = 'zodiac-attar-capricorn.webp'
    elsif ar_scope contains 'aquarius'
      assign ar_bg = 'zodiac-attar-aquarius.webp'
    elsif ar_scope contains 'pisces'
      assign ar_bg = 'zodiac-attar-pisces.webp'
    endif
  endif

  if subtitle_override != blank
    assign ar_subtitle = subtitle_override
  endif

  assign ar_lazy = true
  if card_index <= 2
    assign ar_lazy = false
  endif
  if ar_lazy
    assign ar_loading = 'lazy'
  else
    assign ar_loading = 'eager'
  endif

  if ar_showcase_asset == blank
    capture ar_ck_lookup
      render 'chakra-image-lookup', ck_product: card_product
    endcapture
    assign ar_ck_lookup = ar_ck_lookup | strip
    if ar_ck_lookup != blank
      assign ar_showcase_asset = ar_ck_lookup
    endif
  endif

  if ar_showcase_asset == blank
    capture ar_bs_lookup
      render 'bestseller-image-lookup', bs_product: card_product
    endcapture
    assign ar_bs_lookup = ar_bs_lookup | strip
    if ar_bs_lookup != blank
      assign ar_showcase_asset = ar_bs_lookup
    endif
  endif

  assign ar_variant = card_product.selected_or_first_available_variant
  assign ar_on_sale = false
  if card_product.compare_at_price > card_product.price
    assign ar_on_sale = true
  endif

  assign ar_badge = ''
  if ar_variant.available == false
    assign ar_badge = 'Sold out'
  elsif ar_is_bestseller
    assign ar_badge = 'Bestseller'
  elsif card_product.tags contains 'new' or card_product.tags contains 'New'
    assign ar_badge = 'New'
  elsif ar_on_sale
    assign ar_badge = 'Sale'
  endif

  assign ar_display_title = card_product.title | strip
  if ar_display_title contains ' Attar'
    assign ar_display_title = ar_display_title | replace: ' Attar', '' | strip
  endif

  assign ar_notes_raw = card_product.metafields.custom.main_notes.value | default: card_product.metafields.custom.top_notes.value | default: ''
  assign ar_notes_show = ''
  assign ar_notes_n = 0
  if ar_notes_raw != blank
    assign ar_notes_bits = ar_notes_raw | replace: ' · ', ',' | replace: ' & ', ',' | split: ','
    for ar_note in ar_notes_bits
      assign ar_note_clean = ar_note | strip
      if ar_note_clean != blank and ar_notes_n < 2
        if ar_notes_show != blank
          assign ar_notes_show = ar_notes_show | append: ' · '
        endif
        assign ar_notes_show = ar_notes_show | append: ar_note_clean
        assign ar_notes_n = ar_notes_n | plus: 1
      endif
    endfor
  endif

  assign ar_show_type = true
  if ar_subtitle == 'Attar' or ar_subtitle == 'Gourmand'
    assign ar_show_type = false
  endif

  assign ar_hover_media = blank
  if ar_showcase_asset == blank and card_product.media.size > 1
    for media in card_product.media offset: 1 limit: 4
      if media.media_type == 'image'
        assign ar_hover_media = media
        break
      endif
    endfor
  endif

  capture ar_img_alt
    render 'image-seo-alt', seo_product: card_product, img_context: 'card'
  endcapture
  assign ar_img_alt = ar_img_alt | strip | default: card_product.title

  capture ar_img_alt_hover
    render 'image-seo-alt', seo_product: card_product, img_context: 'hover'
  endcapture
  assign ar_img_alt_hover = ar_img_alt_hover | strip | default: ar_img_alt
-%}

<li class="afr__prod" style="--afr-i: {{ card_index | minus: 1 }};">
  <article class="afr__prod-card{% unless ar_variant.available %} afr__prod-card--sold{% endunless %}">
    <div class="afr__prod-media">
      <a
        href="{{ card_product.url }}"
        class="afr__prod-img-wrap"
        aria-label="{{ card_product.title | escape }}"
      >
        {%- if ar_showcase_asset != blank -%}
          <img
            class="afr__prod-img afr__prod-img--primary"
            src="{{ ar_showcase_asset | asset_url }}"
            alt="{{ ar_img_alt | escape }}"
            width="480"
            height="600"
            {% if ar_lazy %}loading="lazy" decoding="async"{% else %}loading="eager" decoding="async" fetchpriority="high"{% endif %}
          >
        {%- elsif ar_img -%}
          <picture>
            <source
              type="image/webp"
              srcset="{{ ar_img | image_url: width: 320, format: 'webp' }} 320w, {{ ar_img | image_url: width: 480, format: 'webp' }} 480w, {{ ar_img | image_url: width: 720, format: 'webp' }} 720w"
              sizes="(max-width: 767px) 72vw, 200px"
            >
            {{
              ar_img
              | image_url: width: 720
              | image_tag:
                class: 'afr__prod-img afr__prod-img--primary',
                loading: ar_loading,
                widths: '320, 480, 720',
                sizes: '(max-width: 767px) 72vw, 200px',
                alt: ar_img_alt,
                width: 480,
                height: 600,
                decoding: 'async'
            }}
          </picture>
          {%- if ar_hover_media != blank -%}
            {{
              ar_hover_media
              | image_url: width: 720
              | image_tag:
                class: 'afr__prod-img afr__prod-img--hover',
                loading: 'lazy',
                widths: '320, 480, 720',
                sizes: '(max-width: 767px) 72vw, 200px',
                alt: ar_img_alt_hover,
                width: 480,
                height: 600,
                decoding: 'async'
            }}
          {%- endif -%}
        {%- elsif ar_img_fallback != blank -%}
          <img
            class="afr__prod-img afr__prod-img--primary"
            src="{{ ar_img_fallback | asset_url }}"
            alt="{{ ar_img_alt | escape }}"
            width="480"
            height="600"
            {% if ar_lazy %}loading="lazy" decoding="async"{% else %}loading="eager" decoding="async"{% endif %}
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'afr__prod-img' }}
        {%- endif -%}
      </a>
      {%- if ar_badge != blank -%}
        <span class="afr__prod-badge{% if ar_badge == 'Sale' %} afr__prod-badge--sale{% elsif ar_badge == 'Sold out' %} afr__prod-badge--sold{% endif %}">{{ ar_badge }}</span>
      {%- endif -%}
    </div>

    <div class="afr__prod-body">
      <h3 class="afr__prod-name">
        <a href="{{ card_product.url }}">{{ ar_display_title }}</a>
      </h3>
      {%- if ar_notes_show != blank -%}
        <p class="afr__prod-notes">{{ ar_notes_show | escape }}</p>
      {%- elsif ar_show_type -%}
        <p class="afr__prod-type">{{ ar_subtitle }}</p>
      {%- endif -%}
      <div class="afr__prod-foot">
        <div class="afr__prod-prices">
          {%- if ar_on_sale -%}
            <span class="afr__prod-compare">{{ card_product.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="afr__prod-price-now">{{ card_product.price | money }}</span>
        </div>
        <a href="{{ card_product.url }}" class="afr__prod-view">View</a>
      </div>
      <button
        type="button"
        class="afr__prod-atc js-arc-atc"
        data-id="{{ ar_variant.id }}"
        aria-label="Add {{ card_product.title | escape }} to cart"
        {% unless ar_variant.available %}disabled{% endunless %}
      >
        {%- if ar_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
      </button>
    </div>
  </article>
</li>
