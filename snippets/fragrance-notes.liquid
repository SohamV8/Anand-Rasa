{%- comment -%}
  Premium fragrance pyramid — Top / Heart (incl. Middle) / Base with ingredient cards.
{%- endcomment -%}
{%- if product != blank -%}
  {%- liquid
    assign fn_top_field = product.metafields.custom.top_notes
    assign fn_heart_field = product.metafields.custom.heart_notes
    assign fn_middle_field = product.metafields.custom.middle_notes
    assign fn_base_field = product.metafields.custom.base_notes
  -%}
  {%- capture fn_top -%}{%- render 'fragrance-notes-normalize', notes: fn_top_field.value, notes_type: fn_top_field.type -%}{%- endcapture -%}
  {%- capture fn_heart_meta -%}{%- render 'fragrance-notes-normalize', notes: fn_heart_field.value, notes_type: fn_heart_field.type -%}{%- endcapture -%}
  {%- capture fn_middle_meta -%}{%- render 'fragrance-notes-normalize', notes: fn_middle_field.value, notes_type: fn_middle_field.type -%}{%- endcapture -%}
  {%- capture fn_base -%}{%- render 'fragrance-notes-normalize', notes: fn_base_field.value, notes_type: fn_base_field.type -%}{%- endcapture -%}
  {%- liquid
    assign fn_top = fn_top | strip
    assign fn_heart_meta = fn_heart_meta | strip
    assign fn_middle_meta = fn_middle_meta | strip
    assign fn_base = fn_base | strip
  -%}
  {%- comment -%} Heart Notes and Middle Notes are the same tier — coalesce + dedupe. {%- endcomment -%}
  {%- capture fn_mid -%}
    {%- render 'fragrance-notes-merge', notes_a: fn_heart_meta, notes_b: fn_middle_meta -%}
  {%- endcapture -%}
  {%- liquid
    assign fn_mid = fn_mid | strip

    assign fn_desc_html_raw = product.description | default: ''
  -%}
  {%- capture fn_desc_html -%}
    {%- render 'fragrance-notes-normalize-headings', text: fn_desc_html_raw -%}
  {%- endcapture -%}
  {%- liquid
    assign fn_desc_html = fn_desc_html | strip
    assign fn_desc = fn_desc_html | strip_html | strip
  -%}
  {%- capture fn_desc -%}
    {%- render 'fragrance-notes-normalize-headings', text: fn_desc -%}
  {%- endcapture -%}
  {%- liquid
    assign fn_desc = fn_desc | strip
    assign fn_desc = fn_desc | replace: 'AROMA PROFILE', 'Aroma Profile' | replace: 'BENEFITS OF', 'Benefits of' | replace: 'KEY TRADITIONAL INGREDIENTS', 'Key Traditional Ingredients'

    if fn_top == blank and fn_desc_html contains 'Top Notes'
      assign fn_top_section = fn_desc_html | split: 'Top Notes' | last | split: 'Middle Notes' | first | split: 'Heart Notes' | first | split: 'Base Notes' | first
      capture fn_top
        render 'fragrance-notes-normalize', notes: fn_top_section
      endcapture
      assign fn_top = fn_top | strip
    elsif fn_top == blank and fn_desc contains 'Top Notes'
      assign fn_top_chunks = fn_desc | split: 'Top Notes'
      if fn_top_chunks.size > 1
        assign fn_top_raw = fn_top_chunks[1] | split: 'Middle Notes' | first | split: 'Heart Notes' | first | split: 'Base Notes' | first
        assign fn_top_parts = fn_top_raw | split: ':'
        if fn_top_parts.size > 1
          assign fn_top_extract = fn_top_parts[1] | strip
        else
          assign fn_top_extract = fn_top_raw | replace: ':', '' | strip
        endif
        capture fn_top
          render 'fragrance-notes-normalize', notes: fn_top_extract
        endcapture
        assign fn_top = fn_top | strip
      endif
    endif

    comment
      Description fallback for Heart/Middle (same tier). Pull both labels and merge/dedupe.
      Supports singular "Heart Note" / "Middle Note" via heading normalizer above.
    endcomment
    assign fn_mid_desc_a = ''
    assign fn_mid_desc_b = ''
  -%}
  {%- if fn_mid == blank -%}
    {%- if fn_desc_html contains 'Middle Notes' -%}
      {%- assign fn_mid_section = fn_desc_html | split: 'Middle Notes' | last | split: 'Heart Notes' | first | split: 'Base Notes' | first -%}
      {%- capture fn_mid_desc_a -%}{%- render 'fragrance-notes-normalize', notes: fn_mid_section -%}{%- endcapture -%}
      {%- assign fn_mid_desc_a = fn_mid_desc_a | strip -%}
    {%- elsif fn_desc contains 'Middle Notes' -%}
      {%- assign fn_mid_chunks = fn_desc | split: 'Middle Notes' -%}
      {%- if fn_mid_chunks.size > 1 -%}
        {%- assign fn_mid_raw = fn_mid_chunks[1] | split: 'Heart Notes' | first | split: 'Base Notes' | first -%}
        {%- assign fn_mid_parts = fn_mid_raw | split: ':' -%}
        {%- if fn_mid_parts.size > 1 -%}
          {%- assign fn_mid_extract = fn_mid_parts[1] | strip -%}
        {%- else -%}
          {%- assign fn_mid_extract = fn_mid_raw | replace: ':', '' | strip -%}
        {%- endif -%}
        {%- capture fn_mid_desc_a -%}{%- render 'fragrance-notes-normalize', notes: fn_mid_extract -%}{%- endcapture -%}
        {%- assign fn_mid_desc_a = fn_mid_desc_a | strip -%}
      {%- endif -%}
    {%- endif -%}

    {%- if fn_desc_html contains 'Heart Notes' -%}
      {%- assign fn_mid_section = fn_desc_html | split: 'Heart Notes' | last | split: 'Middle Notes' | first | split: 'Base Notes' | first -%}
      {%- capture fn_mid_desc_b -%}{%- render 'fragrance-notes-normalize', notes: fn_mid_section -%}{%- endcapture -%}
      {%- assign fn_mid_desc_b = fn_mid_desc_b | strip -%}
    {%- elsif fn_desc contains 'Heart Notes' -%}
      {%- assign fn_mid_chunks = fn_desc | split: 'Heart Notes' -%}
      {%- if fn_mid_chunks.size > 1 -%}
        {%- assign fn_mid_raw = fn_mid_chunks[1] | split: 'Middle Notes' | first | split: 'Base Notes' | first -%}
        {%- assign fn_mid_parts = fn_mid_raw | split: ':' -%}
        {%- if fn_mid_parts.size > 1 -%}
          {%- assign fn_mid_extract = fn_mid_parts[1] | strip -%}
        {%- else -%}
          {%- assign fn_mid_extract = fn_mid_raw | replace: ':', '' | strip -%}
        {%- endif -%}
        {%- capture fn_mid_desc_b -%}{%- render 'fragrance-notes-normalize', notes: fn_mid_extract -%}{%- endcapture -%}
        {%- assign fn_mid_desc_b = fn_mid_desc_b | strip -%}
      {%- endif -%}
    {%- endif -%}

    {%- capture fn_mid -%}
      {%- render 'fragrance-notes-merge', notes_a: fn_mid_desc_a, notes_b: fn_mid_desc_b -%}
    {%- endcapture -%}
    {%- assign fn_mid = fn_mid | strip -%}
  {%- endif -%}

  {%- liquid
    if fn_base == blank and fn_desc_html contains 'Base Notes'
      assign fn_base_section = fn_desc_html | split: 'Base Notes' | last | split: 'Key Traditional Ingredients' | first | split: 'Aroma Profile' | first | split: 'Benefits of' | first | split: 'Benefits' | first | split: 'Longevity' | first | split: 'Best for' | first | split: 'Why Choose' | first | split: 'Specifications' | first
      capture fn_base
        render 'fragrance-notes-normalize', notes: fn_base_section
      endcapture
      assign fn_base = fn_base | strip
    elsif fn_base == blank and fn_desc contains 'Base Notes'
      assign fn_base_chunks = fn_desc | split: 'Base Notes'
      if fn_base_chunks.size > 1
        assign fn_base_raw = fn_base_chunks[1] | split: 'Key Traditional Ingredients' | first | split: 'Aroma Profile' | first | split: 'Benefits of' | first | split: 'Benefits' | first | split: 'Longevity' | first | split: 'Best for' | first | split: 'Why Choose' | first | split: 'Specifications' | first
        assign fn_base_parts = fn_base_raw | split: ':'
        if fn_base_parts.size > 1
          assign fn_base_extract = fn_base_parts[1] | strip
        else
          assign fn_base_extract = fn_base_raw | replace: ':', '' | strip
        endif
        capture fn_base
          render 'fragrance-notes-normalize', notes: fn_base_extract
        endcapture
        assign fn_base = fn_base | strip
      endif
    endif

    if fn_top != blank
      assign fn_top = fn_top | split: 'Key Traditional Ingredients' | first | split: 'Aroma Profile' | first | split: 'Benefits of' | first | split: 'Benefits' | first | split: 'Longevity' | first | split: 'Best for' | first | strip
    endif
    if fn_mid != blank
      assign fn_mid = fn_mid | split: 'Key Traditional Ingredients' | first | split: 'Aroma Profile' | first | split: 'Benefits of' | first | split: 'Benefits' | first | split: 'Longevity' | first | split: 'Best for' | first | strip
    endif
    if fn_base != blank
      assign fn_base = fn_base | split: 'Key Traditional Ingredients' | first | split: 'Aroma Profile' | first | split: 'Benefits of' | first | split: 'Benefits' | first | split: 'Longevity' | first | split: 'Best for' | first | split: 'Why Choose' | first | split: 'Specifications' | first | strip
    endif
  -%}
  {%- comment -%} Keep tiers clean: Heart notes must not also appear under Top; Base not under Heart/Top. {%- endcomment -%}
  {%- if fn_mid != blank and fn_top != blank -%}
    {%- capture fn_top -%}{%- render 'fragrance-notes-subtract', source_notes: fn_top, remove_notes: fn_mid -%}{%- endcapture -%}
    {%- assign fn_top = fn_top | strip -%}
  {%- endif -%}
  {%- if fn_base != blank and fn_mid != blank -%}
    {%- capture fn_mid -%}{%- render 'fragrance-notes-subtract', source_notes: fn_mid, remove_notes: fn_base -%}{%- endcapture -%}
    {%- assign fn_mid = fn_mid | strip -%}
  {%- endif -%}
  {%- if fn_base != blank and fn_top != blank -%}
    {%- capture fn_top -%}{%- render 'fragrance-notes-subtract', source_notes: fn_top, remove_notes: fn_base -%}{%- endcapture -%}
    {%- assign fn_top = fn_top | strip -%}
  {%- endif -%}
  {%- liquid
    assign fn_count = 0
    if fn_top != blank
      assign fn_count = fn_count | plus: 1
    endif
    if fn_mid != blank
      assign fn_count = fn_count | plus: 1
    endif
    if fn_base != blank
      assign fn_count = fn_count | plus: 1
    endif
  -%}

  {%- if fn_count > 0 -%}
    {%- liquid
      assign fn_default_tab = ''
      if fn_top != blank
        assign fn_default_tab = 'top'
      elsif fn_mid != blank
        assign fn_default_tab = 'mid'
      elsif fn_base != blank
        assign fn_default_tab = 'base'
      endif

      assign fn_uid = product.id
    -%}

    <section
      class="ar-fn ar-fn--full js-ar-fn"
      aria-labelledby="ar-fn-title-{{ fn_uid }}"
      data-ar-fn-section
    >
      <div class="ar-fn__header">
        <div class="ar-fn__header-row">
          <h2 id="ar-fn-title-{{ fn_uid }}" class="ar-fn__title">Fragrance Notes</h2>
          <button
            type="button"
            class="ar-fn__see-all"
            data-ar-fn-see-all
            aria-haspopup="dialog"
            aria-controls="ar-fn-modal-{{ fn_uid }}"
          >
            See all
          </button>
        </div>
        <p class="ar-fn__subtitle">A harmonious blend crafted with the finest natural notes.</p>
      </div>

      <div
        class="ar-fn__tabs"
        role="tablist"
        aria-label="Fragrance note categories"
        data-ar-fn-tabs
      >
        {%- if fn_top != blank -%}
          <button
            type="button"
            class="ar-fn__tab{% if fn_default_tab == 'top' %} ar-fn__tab--active{% endif %}"
            role="tab"
            id="ar-fn-tab-top-{{ fn_uid }}"
            aria-controls="ar-fn-panel-top-{{ fn_uid }}"
            aria-selected="{% if fn_default_tab == 'top' %}true{% else %}false{% endif %}"
            tabindex="{% if fn_default_tab == 'top' %}0{% else %}-1{% endif %}"
            data-ar-fn-tab="top"
          >
            Top
          </button>
        {%- endif -%}
        {%- if fn_mid != blank -%}
          <button
            type="button"
            class="ar-fn__tab{% if fn_default_tab == 'mid' %} ar-fn__tab--active{% endif %}"
            role="tab"
            id="ar-fn-tab-mid-{{ fn_uid }}"
            aria-controls="ar-fn-panel-mid-{{ fn_uid }}"
            aria-selected="{% if fn_default_tab == 'mid' %}true{% else %}false{% endif %}"
            tabindex="{% if fn_default_tab == 'mid' %}0{% else %}-1{% endif %}"
            data-ar-fn-tab="mid"
          >
            Heart
          </button>
        {%- endif -%}
        {%- if fn_base != blank -%}
          <button
            type="button"
            class="ar-fn__tab{% if fn_default_tab == 'base' %} ar-fn__tab--active{% endif %}"
            role="tab"
            id="ar-fn-tab-base-{{ fn_uid }}"
            aria-controls="ar-fn-panel-base-{{ fn_uid }}"
            aria-selected="{% if fn_default_tab == 'base' %}true{% else %}false{% endif %}"
            tabindex="{% if fn_default_tab == 'base' %}0{% else %}-1{% endif %}"
            data-ar-fn-tab="base"
          >
            Base
          </button>
        {%- endif -%}
      </div>

      <div class="ar-fn__frame" style="--ar-fn-cols: {{ fn_count }};">
        <div class="ar-fn__grid">
          {%- if fn_top != blank -%}
            <article
              class="ar-fn__cell ar-fn__cell--top{% if fn_default_tab == 'top' %} ar-fn__cell--active{% endif %}"
              role="tabpanel"
              id="ar-fn-panel-top-{{ fn_uid }}"
              aria-labelledby="ar-fn-tab-top-{{ fn_uid }}"
              data-ar-fn-panel="top"
            >
              <h3 class="ar-fn__label">Top Notes</h3>
              {% render 'fragrance-note-cards', notes_text: fn_top, tier: 'top' %}
            </article>
          {%- endif -%}

          {%- if fn_mid != blank -%}
            <article
              class="ar-fn__cell ar-fn__cell--mid{% if fn_default_tab == 'mid' %} ar-fn__cell--active{% endif %}"
              role="tabpanel"
              id="ar-fn-panel-mid-{{ fn_uid }}"
              aria-labelledby="ar-fn-tab-mid-{{ fn_uid }}"
              data-ar-fn-panel="mid"
            >
              <h3 class="ar-fn__label">Heart Notes</h3>
              {% render 'fragrance-note-cards', notes_text: fn_mid, tier: 'mid' %}
            </article>
          {%- endif -%}

          {%- if fn_base != blank -%}
            <article
              class="ar-fn__cell ar-fn__cell--base{% if fn_default_tab == 'base' %} ar-fn__cell--active{% endif %}"
              role="tabpanel"
              id="ar-fn-panel-base-{{ fn_uid }}"
              aria-labelledby="ar-fn-tab-base-{{ fn_uid }}"
              data-ar-fn-panel="base"
            >
              <h3 class="ar-fn__label">Base Notes</h3>
              {% render 'fragrance-note-cards', notes_text: fn_base, tier: 'base' %}
            </article>
          {%- endif -%}
        </div>
      </div>

      <div
        class="ar-fn__modal"
        id="ar-fn-modal-{{ fn_uid }}"
        data-ar-fn-modal
        hidden
        aria-hidden="true"
      >
        <button
          type="button"
          class="ar-fn__modal-backdrop"
          data-ar-fn-modal-close
          aria-label="Close fragrance notes"
          tabindex="-1"
        ></button>
        <div
          class="ar-fn__modal-sheet"
          role="dialog"
          aria-modal="true"
          aria-labelledby="ar-fn-modal-title-{{ fn_uid }}"
          tabindex="-1"
        >
          <div class="ar-fn__modal-grabber" aria-hidden="true"></div>
          <div class="ar-fn__modal-header">
            <h2 class="ar-fn__modal-title" id="ar-fn-modal-title-{{ fn_uid }}">Fragrance Notes</h2>
            <button
              type="button"
              class="ar-fn__modal-close"
              data-ar-fn-modal-close
              aria-label="Close"
            >
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="ar-fn__modal-body">
            {%- if fn_top != blank -%}
              <section class="ar-fn__modal-tier">
                <h3 class="ar-fn__modal-tier-label">Top</h3>
                {% render 'fragrance-note-cards', notes_text: fn_top, tier: 'top' %}
              </section>
            {%- endif -%}
            {%- if fn_mid != blank -%}
              <section class="ar-fn__modal-tier">
                <h3 class="ar-fn__modal-tier-label">Heart</h3>
                {% render 'fragrance-note-cards', notes_text: fn_mid, tier: 'mid' %}
              </section>
            {%- endif -%}
            {%- if fn_base != blank -%}
              <section class="ar-fn__modal-tier">
                <h3 class="ar-fn__modal-tier-label">Base</h3>
                {% render 'fragrance-note-cards', notes_text: fn_base, tier: 'base' %}
              </section>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}
