{%- comment -%} 1. HERO — full-bleed asset video only (GPU-friendly) {%- endcomment -%}
{%- liquid
  assign ar_hero_video_mp4 = 'Website Main Page1.mp4' | asset_url
  if section.settings.hero_image != blank
    assign ar_hero_poster = section.settings.hero_image | image_url: width: 1920
  else
    assign ar_hero_poster = 'home.webp' | asset_url
  endif
  assign ar_hero_title = section.settings.hero_headline | default: shop.name | strip_html | strip
-%}
<section class="ar-hero" data-ar-hero aria-label="{{ ar_hero_title | escape }}">
  <h1 class="ar-hero__sr-only">{{ ar_hero_title | escape }}</h1>

  <div class="ar-hero__media" aria-hidden="true">
    <video
      class="ar-hero__video"
      data-ar-hero-video
      muted
      loop
      playsinline
      webkit-playsinline
      preload="metadata"
      poster="{{ ar_hero_poster | escape }}"
      width="1920"
      height="1080"
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
    >
      <source src="{{ ar_hero_video_mp4 }}" type="video/mp4">
    </video>
    <div class="ar-hero__poster" style="background-image: url('{{ ar_hero_poster | escape }}');"></div>
  </div>
</section>

<style>
/* Full native 16:9 video — never crop, never stretch */
.ar-hero {
  position: relative;
  isolation: isolate;
  background: #0f0e0c;
  overflow: hidden;
  margin: 0;
  padding: 0;
  width: 100%;
  max-width: 100%;
  height: auto;
  min-height: 0;
  aspect-ratio: 16 / 9;
  contain: layout paint style;
}

.ar-hero__sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.ar-hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: #0f0e0c;
  contain: strict;
}

.ar-hero__video {
  display: block;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  max-width: 100%;
  object-fit: contain;
  object-position: center center;
  z-index: 0;
  pointer-events: none;
  /* Promote one compositor layer without permanent will-change cost */
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  contain: paint;
}

.ar-hero__poster {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-color: #0f0e0c;
  background-position: center center;
  background-size: contain;
  background-repeat: no-repeat;
  opacity: 0;
  pointer-events: none;
  transform: translateZ(0);
}

@media (prefers-reduced-motion: reduce) {
  .ar-hero__video {
    display: none !important;
  }

  .ar-hero__poster {
    opacity: 1;
  }
}
</style>

<script>
  (function () {
    var root = document.querySelector('[data-ar-hero]');
    if (!root || root.dataset.arHeroBound === 'true') return;
    root.dataset.arHeroBound = 'true';

    var video = root.querySelector('[data-ar-hero-video]');
    if (!video) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var inView = true;
    var pageVisible = !document.hidden;

    function canPlay() {
      return !reduce.matches && inView && pageVisible;
    }

    function playSafe(el) {
      if (!el) return;
      el.muted = true;
      var p = el.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    }

    function syncPlayback() {
      if (!canPlay()) {
        if (!video.paused) video.pause();
        video.removeAttribute('autoplay');
        return;
      }
      video.setAttribute('autoplay', '');
      playSafe(video);
    }

    syncPlayback();

    if (typeof reduce.addEventListener === 'function') {
      reduce.addEventListener('change', syncPlayback);
    } else if (typeof reduce.addListener === 'function') {
      reduce.addListener(syncPlayback);
    }

    document.addEventListener('visibilitychange', function () {
      pageVisible = !document.hidden;
      syncPlayback();
    });

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          var entry = entries[0];
          if (!entry) return;
          inView = entry.isIntersecting && entry.intersectionRatio > 0.12;
          syncPlayback();
        },
        { root: null, rootMargin: '0px', threshold: [0, 0.12, 0.35] }
      );
      io.observe(root);
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (!event.target || !event.target.querySelector || !event.target.querySelector('[data-ar-hero]')) return;
      var next = event.target.querySelector('[data-ar-hero-video]');
      if (!next || reduce.matches) return;
      playSafe(next);
    });
  })();
</script>
