{%- comment -%}
  Homepage hero — poster-first LCP, deferred WebM (device-specific), GPU-friendly.
  Video must NOT compete with the poster on Slow 4G: wait for LCP to settle.
{%- endcomment -%}
{%- liquid
  assign ar_hero_video_desktop_webm = 'hero-home-desktop.webm' | asset_url
  assign ar_hero_video_desktop_mp4 = 'hero-home-desktop.mp4' | asset_url
  assign ar_hero_video_mobile_webm = 'hero-home-mobile.webm' | asset_url
  assign ar_hero_video_mobile_mp4 = 'hero-home-mobile.mp4' | asset_url
  assign ar_hero_title = section.settings.hero_headline | default: shop.name | strip_html | strip
  assign ar_hero_shop_url = routes.all_products_collection_url | default: '/collections/all'

  if section.settings.hero_image != blank
    assign ar_hero_poster_mobile = section.settings.hero_image | image_url: width: 750, format: 'webp'
    assign ar_hero_poster_tablet = section.settings.hero_image | image_url: width: 1100, format: 'webp'
    assign ar_hero_poster_desktop = section.settings.hero_image | image_url: width: 1600, format: 'webp'
    assign ar_hero_poster_fallback = section.settings.hero_image | image_url: width: 1200, format: 'webp'
  else
    assign ar_hero_poster_mobile = 'home-mobile.webp' | asset_url
    assign ar_hero_poster_tablet = 'home.webp' | asset_url
    assign ar_hero_poster_desktop = 'home.webp' | asset_url
    assign ar_hero_poster_fallback = 'home.webp' | asset_url
  endif
-%}
<section
  class="ar-hero"
  data-ar-hero
  aria-label="{{ ar_hero_title | escape }}"
>
  <h1 class="ar-hero__sr-only">{{ ar_hero_title | escape }}</h1>

  <div class="ar-hero__media" aria-hidden="true">
    {%- comment -%} Immediate LCP visual (poster). Video loads only after JS activates the active device. {%- endcomment -%}
    <picture class="ar-hero__poster">
      <source
        media="(max-width: 749px)"
        srcset="{{ ar_hero_poster_mobile | escape }}"
      >
      <source
        media="(max-width: 1100px)"
        srcset="{{ ar_hero_poster_tablet | escape }}"
      >
      <img
        class="ar-hero__poster-img"
        src="{{ ar_hero_poster_fallback | escape }}"
        srcset="{{ ar_hero_poster_mobile | escape }} 750w, {{ ar_hero_poster_tablet | escape }} 1100w, {{ ar_hero_poster_desktop | escape }} 1600w"
        sizes="100vw"
        alt=""
        width="1920"
        height="900"
        fetchpriority="high"
        decoding="async"
        loading="eager"
      >
    </picture>

    {%- comment -%} Sources injected by JS for the active device only (preload none until then). {%- endcomment -%}
    {%- comment -%}
      Intrinsic sizes MUST match the WebM files exactly:
      desktop = 1920×900 (DAR 32:15), mobile = 960×864 / DAR ~4:5.
      Wrong width/height + object-fit:cover was cropping/stretching the hero.
    {%- endcomment -%}
    <video
      class="ar-hero__video ar-hero__video--desktop"
      data-ar-hero-video
      data-ar-device="desktop"
      data-src-webm="{{ ar_hero_video_desktop_webm | escape }}"
      data-src-mp4="{{ ar_hero_video_desktop_mp4 | escape }}"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="none"
      width="1920"
      height="900"
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
      aria-hidden="true"
    ></video>

    <video
      class="ar-hero__video ar-hero__video--mobile"
      data-ar-hero-video
      data-ar-device="mobile"
      data-src-webm="{{ ar_hero_video_mobile_webm | escape }}"
      data-src-mp4="{{ ar_hero_video_mobile_mp4 | escape }}"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="none"
      width="960"
      height="864"
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
      aria-hidden="true"
    ></video>
  </div>

  <a
    href="{{ ar_hero_shop_url }}"
    class="ar-hero__hit"
    aria-label="Shop all fragrances"
  >
    <span class="ar-hero__sr-only">Shop all</span>
  </a>
</section>

<style>
/*
  Permanent fit rule: NEVER crop (cover) or stretch the hero video/poster.
  Frame aspect-ratio matches each WebM's true display ratio; media uses contain.
*/
.ar-hero {
  --ar-hero-desktop-ratio: 1920 / 900; /* hero-home-desktop.webm */
  --ar-hero-mobile-ratio: 4 / 5;       /* hero-home-mobile.webm DAR */
  position: relative;
  isolation: isolate;
  background: #f5f5f5;
  overflow: hidden;
  margin: 0;
  padding: 0;
  width: 100%;
  max-width: 100%;
}

.ar-hero__sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.ar-hero__media {
  position: relative;
  z-index: 0;
  width: 100%;
  max-width: 100%;
  margin-inline: auto;
  aspect-ratio: var(--ar-hero-desktop-ratio);
  overflow: hidden;
  pointer-events: none;
  background: #f5f5f5;
  line-height: 0;
}

.ar-hero__poster {
  position: absolute;
  inset: 0;
  z-index: 1;
  margin: 0;
  display: block;
  width: 100%;
  height: 100%;
  opacity: 1;
  pointer-events: none;
  transform: translateZ(0);
  transition: opacity 0.4s ease;
}

.ar-hero__poster-img,
.ar-hero__video {
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  object-position: center center;
  border: 0;
}

.ar-hero__video {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0;
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transition: opacity 0.4s ease;
}

.ar-hero.is-video-ready .ar-hero__video.is-active {
  opacity: 1;
}

.ar-hero.is-video-ready .ar-hero__poster {
  opacity: 0;
}

.ar-hero__hit {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  cursor: pointer;
  text-decoration: none;
  background: transparent;
  -webkit-tap-highlight-color: transparent;
}

.ar-hero__hit:focus-visible {
  outline: 2px solid #fff;
  outline-offset: -4px;
}

.ar-hero__video--mobile { display: none !important; }

@media (max-width: 749px) {
  .ar-hero__media {
    /* Keep full 4:5 frame visible: shrink width if viewport is shorter than ratio. */
    aspect-ratio: var(--ar-hero-mobile-ratio);
    max-height: 100svh;
    width: min(100%, calc(100svh * 4 / 5));
  }

  .ar-hero__video--desktop { display: none !important; }
  .ar-hero__video--mobile { display: block !important; }
}

@media (prefers-reduced-motion: reduce) {
  .ar-hero__video {
    display: none !important;
  }

  .ar-hero__poster {
    opacity: 1 !important;
    transition: none;
  }

  .ar-hero.is-video-ready .ar-hero__poster {
    opacity: 1 !important;
  }
}
</style>

<script>
  (function () {
    var root = document.querySelector('[data-ar-hero]');
    if (!root || root.dataset.arHeroBound === 'true') return;
    root.dataset.arHeroBound = 'true';

    var videos = root.querySelectorAll('[data-ar-hero-video]');
    if (!videos.length) return;

    var mobileQuery = window.matchMedia('(max-width: 749px)');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var inView = true;
    var pageVisible = !document.hidden;
    var supportsWebm = true;
    var supportsMp4 = true;

    try {
      var probe = document.createElement('video');
      supportsWebm = !!(probe.canPlayType && probe.canPlayType('video/webm; codecs="vp8,vorbis"')) ||
        !!(probe.canPlayType && probe.canPlayType('video/webm; codecs="vp9"')) ||
        !!(probe.canPlayType && probe.canPlayType('video/webm'));
      supportsMp4 = !!(probe.canPlayType && probe.canPlayType('video/mp4; codecs="avc1.42E01E"')) ||
        !!(probe.canPlayType && probe.canPlayType('video/mp4'));
    } catch (e) {
      supportsWebm = false;
      supportsMp4 = false;
    }

    function getConnection() {
      return navigator.connection || navigator.mozConnection || navigator.webkitConnection || null;
    }

    function isConstrainedNetwork() {
      var conn = getConnection();
      if (!conn) return false;
      if (conn.saveData) return true;
      var et = conn.effectiveType;
      return et === 'slow-2g' || et === '2g';
    }

    function lcpBufferMs() {
      if (isConstrainedNetwork()) return 4500;
      var conn = getConnection();
      if (conn && conn.effectiveType === '4g' && typeof conn.downlink === 'number' && conn.downlink >= 5) {
        return 600;
      }
      if (conn && conn.effectiveType === '4g') return 1200;
      return 2800;
    }

    function supportsAnyVideo() {
      return supportsWebm || supportsMp4;
    }

    function activeVideo() {
      var device = mobileQuery.matches ? 'mobile' : 'desktop';
      for (var i = 0; i < videos.length; i++) {
        if (videos[i].getAttribute('data-ar-device') === device) return videos[i];
      }
      return videos[0];
    }

    function canPlay() {
      return supportsAnyVideo() && !reduce.matches && !isConstrainedNetwork() && inView && pageVisible;
    }

    function playSafe(el) {
      if (!el) return;
      el.muted = true;
      var p = el.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    }

    function markReady(el) {
      for (var i = 0; i < videos.length; i++) {
        videos[i].classList.toggle('is-active', videos[i] === el);
      }
      root.classList.add('is-video-ready');
    }

    function ensureSource(el) {
      if (!el || el.dataset.arLoaded === 'true') return;
      var webm = el.getAttribute('data-src-webm');
      var mp4 = el.getAttribute('data-src-mp4');
      if (!webm && !mp4) return;

      if (webm && supportsWebm) {
        var webmSource = document.createElement('source');
        webmSource.src = webm;
        webmSource.type = 'video/webm';
        el.appendChild(webmSource);
      }

      if (mp4 && supportsMp4) {
        var mp4Source = document.createElement('source');
        mp4Source.src = mp4;
        mp4Source.type = 'video/mp4';
        el.appendChild(mp4Source);
      }

      if (!el.querySelector('source')) return;

      el.setAttribute('preload', 'metadata');
      el.load();
      el.dataset.arLoaded = 'true';

      var onReady = function () {
        markReady(el);
        if (canPlay() && activeVideo() === el) playSafe(el);
      };

      if (el.readyState >= 2) {
        onReady();
      } else {
        el.addEventListener('loadeddata', onReady, { once: true });
      }
    }

    function unloadInactive(current) {
      for (var i = 0; i < videos.length; i++) {
        var v = videos[i];
        if (v === current) continue;
        if (!v.paused) v.pause();
        v.classList.remove('is-active');
        v.removeAttribute('autoplay');
      }
    }

    function syncPlayback() {
      if (reduce.matches || !supportsAnyVideo() || isConstrainedNetwork()) {
        root.classList.remove('is-video-ready');
        for (var i = 0; i < videos.length; i++) {
          if (!videos[i].paused) videos[i].pause();
          videos[i].classList.remove('is-active');
        }
        return;
      }

      var current = activeVideo();
      unloadInactive(current);

      if (!canPlay()) {
        if (current && !current.paused) current.pause();
        if (current) current.removeAttribute('autoplay');
        return;
      }

      ensureSource(current);
      if (current.dataset.arLoaded === 'true' && current.readyState >= 2) {
        markReady(current);
        current.setAttribute('autoplay', '');
        playSafe(current);
      }
    }

    var lcpGateOpen = false;
    var pendingStart = false;

    function startWhenIdle() {
      if (!lcpGateOpen) {
        pendingStart = true;
        return;
      }
      var run = function () { syncPlayback(); };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(run, { timeout: 2500 });
      } else {
        window.setTimeout(run, 400);
      }
    }

    function openLcpGate() {
      if (lcpGateOpen) return;
      lcpGateOpen = true;
      if (pendingStart || inView) startWhenIdle();
    }

    /* Keep hero video off the critical path until poster LCP can settle. */
    function armLcpGate() {
      var poster = root.querySelector('.ar-hero__poster-img');
      var armed = false;
      var fallbackMs = 4500;
      var bufferMs = lcpBufferMs();

      function arm() {
        if (armed) return;
        armed = true;
        window.setTimeout(openLcpGate, bufferMs);
      }

      try {
        var po = new PerformanceObserver(function (list) {
          list.getEntries().forEach(function (entry) {
            if (!entry) return;
            if (entry.element === poster) arm();
            else if (entry.url && /home(?:-mobile)?\.webp/i.test(entry.url)) arm();
          });
        });
        po.observe({ type: 'largest-contentful-paint', buffered: true });
      } catch (e) {}

      if (poster) {
        if (poster.complete) arm();
        else poster.addEventListener('load', arm, { once: true });
      }

      window.setTimeout(arm, fallbackMs);

      ['pointerdown', 'touchstart', 'keydown'].forEach(function (evt) {
        window.addEventListener(evt, openLcpGate, { once: true, passive: true });
      });
    }

    if (reduce.matches || !supportsAnyVideo()) {
      return;
    }

    armLcpGate();

    var conn = getConnection();
    if (conn && typeof conn.addEventListener === 'function') {
      conn.addEventListener('change', syncPlayback);
    } else if (conn && typeof conn.addListener === 'function') {
      conn.addListener(syncPlayback);
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          var entry = entries[0];
          if (!entry) return;
          inView = entry.isIntersecting && entry.intersectionRatio > 0.08;
          if (inView) startWhenIdle();
          else syncPlayback();
        },
        { root: null, rootMargin: '80px 0px', threshold: [0, 0.08, 0.25] }
      );
      io.observe(root);
    } else {
      startWhenIdle();
    }

    if (typeof mobileQuery.addEventListener === 'function') {
      mobileQuery.addEventListener('change', syncPlayback);
    } else if (typeof mobileQuery.addListener === 'function') {
      mobileQuery.addListener(syncPlayback);
    }

    if (typeof reduce.addEventListener === 'function') {
      reduce.addEventListener('change', syncPlayback);
    } else if (typeof reduce.addListener === 'function') {
      reduce.addListener(syncPlayback);
    }

    document.addEventListener('visibilitychange', function () {
      pageVisible = !document.hidden;
      syncPlayback();
    });

    document.addEventListener('shopify:section:load', function (event) {
      if (!event.target || !event.target.querySelector || !event.target.querySelector('[data-ar-hero]')) return;
      syncPlayback();
    });
  })();
</script>
