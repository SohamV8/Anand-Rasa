{%- comment -%} 1. HERO — full-bleed asset video only (GPU-friendly) {%- endcomment -%}
{%- liquid
  assign ar_hero_video_mp4 = 'Website Main Page1.mp4' | asset_url
  assign ar_hero_video_mobile = 'Main Page Video Mobile.mp4' | asset_url
  if section.settings.hero_image != blank
    assign ar_hero_poster = section.settings.hero_image | image_url: width: 1920
  else
    assign ar_hero_poster = 'home.webp' | asset_url
  endif
  assign ar_hero_title = section.settings.hero_headline | default: shop.name | strip_html | strip
  assign ar_hero_shop_url = routes.all_products_collection_url | default: '/collections/all'
-%}
<section class="ar-hero" data-ar-hero aria-label="{{ ar_hero_title | escape }}">
  <h1 class="ar-hero__sr-only">{{ ar_hero_title | escape }}</h1>

  <div class="ar-hero__media" aria-hidden="true">
    {%- comment -%} Desktop video (hidden on mobile) {%- endcomment -%}
    <video
      class="ar-hero__video ar-hero__video--desktop"
      data-ar-hero-video
      data-ar-device="desktop"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="metadata"
      poster="{{ ar_hero_poster | escape }}"
      width="1920"
      height="1080"
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
    >
      <source src="{{ ar_hero_video_mp4 }}" type="video/mp4">
    </video>

    {%- comment -%} Mobile video (hidden on desktop) {%- endcomment -%}
    <video
      class="ar-hero__video ar-hero__video--mobile"
      data-ar-hero-video
      data-ar-device="mobile"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="metadata"
      poster="{{ ar_hero_poster | escape }}"
      width="720"
      height="1280"
      disablepictureinpicture
      disableremoteplayback
      tabindex="-1"
    >
      <source src="{{ ar_hero_video_mobile }}" type="video/mp4">
    </video>
    <div class="ar-hero__poster" style="background-image: url('{{ ar_hero_poster | escape }}');"></div>
  </div>

  <a
    href="{{ ar_hero_shop_url }}"
    class="ar-hero__hit"
    aria-label="Shop all fragrances"
  >
    <span class="ar-hero__sr-only">Shop all</span>
  </a>
</section>

<style>
.ar-hero {
  position: relative;
  isolation: isolate;
  background: #fff;
  overflow: hidden;
  margin: 0;
  padding: 0;
  width: 100%;
  max-width: 100%;
}

.ar-hero__sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.ar-hero__media {
  position: relative;
  width: 100%;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: #fff;
  line-height: 0;
}

.ar-hero__video {
  display: block;
  width: 100%;
  height: auto;
  pointer-events: none;
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.ar-hero__poster {
  position: absolute;
  inset: 0;
  z-index: 1;
  background-color: #fff;
  background-position: center center;
  background-size: cover;
  background-repeat: no-repeat;
  opacity: 0;
  pointer-events: none;
  transform: translateZ(0);
}

.ar-hero__hit {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  cursor: pointer;
  text-decoration: none;
  background: transparent;
  -webkit-tap-highlight-color: transparent;
}

.ar-hero__hit:focus-visible {
  outline: 2px solid #fff;
  outline-offset: -4px;
}

.ar-hero__video--mobile { display: none !important; }

@media (max-width: 749px) {
  .ar-hero__video--desktop { display: none !important; }
  .ar-hero__video--mobile { display: block !important; }
}

@media (prefers-reduced-motion: reduce) {
  .ar-hero__video { display: none !important; }
  .ar-hero__poster { opacity: 1; }
}
</style>

<script>
  (function () {
    var root = document.querySelector('[data-ar-hero]');
    if (!root || root.dataset.arHeroBound === 'true') return;
    root.dataset.arHeroBound = 'true';

    var videos = root.querySelectorAll('[data-ar-hero-video]');
    if (!videos.length) return;

    var mobileQuery = window.matchMedia('(max-width: 749px)');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var inView = true;
    var pageVisible = !document.hidden;

    function activeVideo() {
      var device = mobileQuery.matches ? 'mobile' : 'desktop';
      for (var i = 0; i < videos.length; i++) {
        if (videos[i].getAttribute('data-ar-device') === device) return videos[i];
      }
      return videos[0];
    }

    function canPlay() {
      return !reduce.matches && inView && pageVisible;
    }

    function playSafe(el) {
      if (!el) return;
      el.muted = true;
      var p = el.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    }

    function syncPlayback() {
      var current = activeVideo();
      for (var i = 0; i < videos.length; i++) {
        if (videos[i] !== current && !videos[i].paused) {
          videos[i].pause();
          videos[i].removeAttribute('autoplay');
        }
      }
      if (!canPlay()) {
        if (!current.paused) current.pause();
        current.removeAttribute('autoplay');
        return;
      }
      current.setAttribute('autoplay', '');
      playSafe(current);
    }

    syncPlayback();

    if (typeof mobileQuery.addEventListener === 'function') {
      mobileQuery.addEventListener('change', syncPlayback);
    } else if (typeof mobileQuery.addListener === 'function') {
      mobileQuery.addListener(syncPlayback);
    }

    if (typeof reduce.addEventListener === 'function') {
      reduce.addEventListener('change', syncPlayback);
    } else if (typeof reduce.addListener === 'function') {
      reduce.addListener(syncPlayback);
    }

    document.addEventListener('visibilitychange', function () {
      pageVisible = !document.hidden;
      syncPlayback();
    });

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          var entry = entries[0];
          if (!entry) return;
          inView = entry.isIntersecting && entry.intersectionRatio > 0.12;
          syncPlayback();
        },
        { root: null, rootMargin: '0px', threshold: [0, 0.12, 0.35] }
      );
      io.observe(root);
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (!event.target || !event.target.querySelector || !event.target.querySelector('[data-ar-hero]')) return;
      if (reduce.matches) return;
      syncPlayback();
    });
  })();
</script>
