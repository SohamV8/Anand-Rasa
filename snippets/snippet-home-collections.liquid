{%- comment -%}
  Bento grid — 7 collection cards.
  Zodiac · Planet · Perfume · Incense · Gift · Apsara · Bestseller
{%- endcomment -%}
{%- liquid
  assign ar_bg_handles  = 'zodiac-attars|planet-attars|perfume-series|incense-sticks|giftsets|apsara-attars|bestseller' | split: '|'
  assign ar_bg_titles   = 'Zodiac Attars|Planet Attars|Perfume Series|Incense Sticks|Gift Sets|Apsara Attars|Bestsellers' | split: '|'
  assign ar_bg_descs    = 'Discover the mystical fragrances aligned with your zodiac sign.|Planetary essences crafted for cosmic harmony and balance.|Premium perfume blends rooted in ancient attar traditions.|Hand-rolled sacred incense for meditation and rituals.|Curated gift sets for every occasion and celebration.|Celestial fragrances inspired by divine beauty.|Our most loved fragrances picked by our community.' | split: '|'
  assign ar_bg_images   = 'malang.webp|malang.webp|malang.webp|malang.webp|malang.webp|malang.webp|malang.webp' | split: '|'
  assign ar_bg_matches  = 'zodiac|planet|perfume|incense|gift set|apsara|bestseller' | split: '|'
-%}

<section class="ar-bento" aria-label="Explore Collections">
  <div class="ar-bento__grid">
    {%- for handle in ar_bg_handles -%}
      {%- liquid
        assign idx = forloop.index0
        assign title = ar_bg_titles[idx]
        assign desc = ar_bg_descs[idx]
        assign fallback = ar_bg_images[idx]
        assign match_key = ar_bg_matches[idx]

        assign card_img = blank
        for block in section.blocks
          if block.type == 'category'
            assign bt = block.settings.title | downcase
            if bt contains match_key
              if block.settings.image != blank
                assign card_img = block.settings.image
              endif
              break
            endif
          endif
        endfor

        capture card_url
          render 'ar-collection-url', handle: handle
        endcapture
        assign card_url = card_url | strip
        if card_url == blank
          assign card_url = '/collections/' | append: handle
        endif
      -%}

      <a href="{{ card_url }}"
         class="ar-bento__card ar-bento__card--{{ forloop.index }}"
         aria-label="{{ title | escape }}">
        <div class="ar-bento__media">
          {%- if card_img != blank -%}
            <img
              class="ar-bento__img"
              src="{{ card_img | image_url: width: 800 }}"
              srcset="{{ card_img | image_url: width: 400 }} 400w, {{ card_img | image_url: width: 600 }} 600w, {{ card_img | image_url: width: 800 }} 800w"
              sizes="(min-width: 768px) 33vw, 80vw"
              alt="{{ title | escape }}"
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
            >
          {%- else -%}
            <img
              class="ar-bento__img"
              src="{{ fallback | asset_url }}"
              alt="{{ title | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </div>
        <div class="ar-bento__text">
          <h3 class="ar-bento__title">{{ title | escape }}</h3>
          <p class="ar-bento__desc">{{ desc }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
.ar-bento {
  width: 100%;
  margin: 0;
  padding: 40px 24px;
  background: #fff;
  box-sizing: border-box;
}

.ar-bento__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: 280px 200px 260px;
  width: 1400px;
  max-width: 100%;
  gap: 14px;
  margin: 0 auto;
  box-sizing: border-box;
}

/* Card 1 — top-left wide */
.ar-bento__card--1 { grid-column: 1 / 3; grid-row: 1 / 2; }
/* Card 2 — top-right wide */
.ar-bento__card--2 { grid-column: 3 / 5; grid-row: 1 / 2; }
/* Card 3 — left tall (spans rows 2-3) */
.ar-bento__card--3 { grid-column: 1 / 2; grid-row: 2 / 4; }
/* Card 4 — mid-center */
.ar-bento__card--4 { grid-column: 2 / 3; grid-row: 2 / 3; }
/* Card 5 — mid-right wide */
.ar-bento__card--5 { grid-column: 3 / 5; grid-row: 2 / 3; }
/* Card 6 — bottom-center */
.ar-bento__card--6 { grid-column: 2 / 3; grid-row: 3 / 4; }
/* Card 7 — bottom-right wide */
.ar-bento__card--7 { grid-column: 3 / 5; grid-row: 3 / 4; }

.ar-bento__card {
  display: flex;
  overflow: hidden;
  border-radius: 20px;
  background: #f5f3f0;
  text-decoration: none;
  color: #1a1a1a;
  transition: box-shadow .3s ease, transform .3s ease;
  -webkit-tap-highlight-color: transparent;
  outline-offset: 3px;
  box-sizing: border-box;
}

.ar-bento__card:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,.1);
  transform: translateY(-2px);
}

.ar-bento__card:focus-visible {
  outline: 2px solid #1a1a1a;
}

/* ── Flex directions ── */

/* Card 1: image left, text right */
.ar-bento__card--1 { flex-direction: row; }
.ar-bento__card--1 .ar-bento__media { flex: 0 0 45%; }
.ar-bento__card--1 .ar-bento__text  { flex: 0 0 55%; }

/* Card 2: text left, image right */
.ar-bento__card--2 { flex-direction: row; }
.ar-bento__card--2 .ar-bento__media { order: 2; flex: 0 0 60%; }
.ar-bento__card--2 .ar-bento__text  { order: 1; flex: 0 0 40%; }

/* Card 3: tall — image top, text bottom */
.ar-bento__card--3 { flex-direction: column; }
.ar-bento__card--3 .ar-bento__media { flex: 1.6; padding: 24px; }
.ar-bento__card--3 .ar-bento__text  { flex: 1; }

/* Card 4: text left, image right */
.ar-bento__card--4 { flex-direction: row; }
.ar-bento__card--4 .ar-bento__media { order: 2; }
.ar-bento__card--4 .ar-bento__text  { order: 1; }

/* Card 5: text left, image right */
.ar-bento__card--5 { flex-direction: row; }
.ar-bento__card--5 .ar-bento__media { order: 2; }
.ar-bento__card--5 .ar-bento__text  { order: 1; }

/* Card 6: image left, text right */
.ar-bento__card--6 { flex-direction: row; }

/* Card 7: image left, text right */
.ar-bento__card--7 { flex-direction: row; }
.ar-bento__card--7 .ar-bento__media { flex: 0 0 58%; }
.ar-bento__card--7 .ar-bento__text  { flex: 0 0 42%; }

/* ── Text ── */
.ar-bento__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px;
  min-width: 0;
}

.ar-bento__title {
  font-size: clamp(20px, 2vw, 30px);
  font-weight: 800;
  line-height: 1.15;
  margin: 0 0 10px;
  color: #1a1a1a;
  font-style: italic;
}

.ar-bento__desc {
  font-size: clamp(12px, 0.95vw, 14px);
  line-height: 1.55;
  margin: 0;
  color: #666;
}

/* ── Media ── */
.ar-bento__media {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  min-width: 0;
  min-height: 0;
  padding: 16px;
}

.ar-bento__img {
  display: block;
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
  object-position: center;
  transition: transform .4s cubic-bezier(.25,.46,.45,.94);
}

.ar-bento__card:hover .ar-bento__img {
  transform: scale(1.05);
}

/* ── Tablet (750–1023) ── */
@media (max-width: 1023px) and (min-width: 750px) {
  .ar-bento { padding: 30px 16px; }

  .ar-bento__grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    gap: 12px;
  }

  .ar-bento__card--1 { grid-column: 1 / 3; }
  .ar-bento__card--2 { grid-column: 1 / 3; }
  .ar-bento__card--3 { grid-column: 1 / 2; }
  .ar-bento__card--4 { grid-column: 2 / 3; }
  .ar-bento__card--5 { grid-column: 1 / 2; }
  .ar-bento__card--6 { grid-column: 2 / 3; }
  .ar-bento__card--7 { grid-column: 1 / 3; }

  .ar-bento__card--1,
  .ar-bento__card--2,
  .ar-bento__card--3,
  .ar-bento__card--4,
  .ar-bento__card--5,
  .ar-bento__card--6,
  .ar-bento__card--7 {
    grid-row: auto;
  }

  .ar-bento__card--3,
  .ar-bento__card--4,
  .ar-bento__card--5,
  .ar-bento__card--6 {
    flex-direction: column;
  }

  .ar-bento__card--3 .ar-bento__media,
  .ar-bento__card--3 .ar-bento__text,
  .ar-bento__card--4 .ar-bento__media,
  .ar-bento__card--4 .ar-bento__text,
  .ar-bento__card--5 .ar-bento__media,
  .ar-bento__card--5 .ar-bento__text,
  .ar-bento__card--6 .ar-bento__media,
  .ar-bento__card--6 .ar-bento__text {
    order: unset;
    flex: unset;
  }

  .ar-bento__media { min-height: 180px; }
  .ar-bento__text { padding: 22px; }
}

/* ── Mobile (<750) ── */
@media (max-width: 749px) {
  .ar-bento { padding: 16px 12px; }

  .ar-bento__grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    gap: 12px;
  }

  .ar-bento__card--1,
  .ar-bento__card--2,
  .ar-bento__card--3,
  .ar-bento__card--4,
  .ar-bento__card--5,
  .ar-bento__card--6,
  .ar-bento__card--7 {
    grid-column: 1 / -1;
    grid-row: auto;
    flex-direction: column;
  }

  .ar-bento__card--1 .ar-bento__media,
  .ar-bento__card--1 .ar-bento__text,
  .ar-bento__card--2 .ar-bento__media,
  .ar-bento__card--2 .ar-bento__text,
  .ar-bento__card--3 .ar-bento__media,
  .ar-bento__card--3 .ar-bento__text,
  .ar-bento__card--4 .ar-bento__media,
  .ar-bento__card--4 .ar-bento__text,
  .ar-bento__card--5 .ar-bento__media,
  .ar-bento__card--5 .ar-bento__text,
  .ar-bento__card--6 .ar-bento__media,
  .ar-bento__card--6 .ar-bento__text,
  .ar-bento__card--7 .ar-bento__media,
  .ar-bento__card--7 .ar-bento__text {
    order: unset;
    flex: unset;
  }

  .ar-bento__media {
    min-height: 200px;
    max-height: 260px;
    padding: 20px;
  }

  .ar-bento__text { padding: 24px 20px; }
  .ar-bento__title { font-size: 22px; margin-bottom: 8px; }
  .ar-bento__desc { font-size: 14px; }
  .ar-bento__card { border-radius: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  .ar-bento__card:hover .ar-bento__img { transform: none; }
  .ar-bento__card:hover { transform: none; }
}
</style>
