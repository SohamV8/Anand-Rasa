{%- comment -%}
  Bento grid — 6 collection cards, 100vh.
  Zodiac · Planet · Perfume · Incense · Gift · Apsara
{%- endcomment -%}
{%- liquid
  assign ar_bg_handles  = 'zodiac-attars|planet-attars|perfume-series|incense-sticks|giftsets|apsara-attars' | split: '|'
  assign ar_bg_titles   = 'Zodiac Attars|Planet Attars|Perfume Series|Incense Sticks|Gift Sets|Apsara Attars' | split: '|'
  assign ar_bg_images   = 'zodiac.webp|planets.webp|Perfume Series.webp|incense_stick.webp|Gift Set.webp|Apsara Attar.webp' | split: '|'
  assign ar_bg_matches  = 'zodiac|planet|perfume|incense|gift set|apsara' | split: '|'
-%}

<section class="ar-bento" aria-label="Explore Collections">
  <div class="ar-bento__grid">
    {%- for handle in ar_bg_handles -%}
      {%- liquid
        assign idx = forloop.index0
        assign title = ar_bg_titles[idx]
        assign fallback = ar_bg_images[idx]
        assign match_key = ar_bg_matches[idx]

        assign card_img = blank
        for block in section.blocks
          if block.type == 'category'
            assign bt = block.settings.title | downcase
            if bt contains match_key
              if block.settings.image != blank
                assign card_img = block.settings.image
              endif
              break
            endif
          endif
        endfor

        capture card_url
          render 'ar-collection-url', handle: handle
        endcapture
        assign card_url = card_url | strip
        if card_url == blank
          assign card_url = '/collections/' | append: handle
        endif
      -%}

      <a href="{{ card_url }}"
         class="ar-bento__card ar-bento__card--{{ forloop.index }}"
         aria-label="{{ title | escape }}">
        <div class="ar-bento__media">
          {%- if card_img != blank -%}
            <img
              class="ar-bento__img"
              src="{{ card_img | image_url: width: 900 }}"
              srcset="{{ card_img | image_url: width: 480 }} 480w, {{ card_img | image_url: width: 720 }} 720w, {{ card_img | image_url: width: 900 }} 900w"
              sizes="(min-width: 768px) 33vw, 50vw"
              alt="{{ title | escape }}"
              loading="lazy"
              decoding="async"
              width="900"
              height="600"
            >
          {%- else -%}
            <img
              class="ar-bento__img"
              src="{{ fallback | asset_url }}"
              alt="{{ title | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
          <span class="ar-bento__shade" aria-hidden="true"></span>
        </div>
        <span class="ar-bento__label">{{ title | escape }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
/* ── Bento wrapper ── */
.ar-bento {
  width: 100%;
  margin: 0;
  padding: 0;
  background: #fff;
  contain: layout style;
}

/* ── Grid: 4 columns × 4 rows, centred, max-width ── */
.ar-bento__grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  grid-template-rows: 3fr 2fr 2fr;
  width: 1400px;
  max-width: 100%;
  height: 700px;
  gap: 8px;
  padding: 8px;
  margin: 0 auto;
  background: #fff;
  border-radius: 16px;
  box-sizing: border-box;
}

/* ── Card 1 — top-left, wide (2 of 4 cols, row 1) ── */
.ar-bento__card--1 {
  grid-column: 1 / 3;
  grid-row: 1 / 2;
}

/* ── Card 2 — top-right, tall (2 of 4 cols, spans rows 1-2) ── */
.ar-bento__card--2 {
  grid-column: 3 / 5;
  grid-row: 1 / 3;
}

/* ── Card 3 — middle-left small ── */
.ar-bento__card--3 {
  grid-column: 1 / 2;
  grid-row: 2 / 3;
}

/* ── Card 4 — middle-center small ── */
.ar-bento__card--4 {
  grid-column: 2 / 3;
  grid-row: 2 / 3;
}

/* ── Card 5 — bottom-left small ── */
.ar-bento__card--5 {
  grid-column: 1 / 2;
  grid-row: 3 / 4;
}

/* ── Card 6 — bottom-right, wide (3 of 4 cols, row 3) ── */
.ar-bento__card--6 {
  grid-column: 2 / 5;
  grid-row: 3 / 4;
}

/* ── Card base ── */
.ar-bento__card {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  text-decoration: none;
  color: #fff;
  transform: translateZ(0);
  -webkit-tap-highlight-color: transparent;
  outline-offset: 3px;
}

.ar-bento__card:focus-visible {
  outline: 2px solid #fff;
}

/* ── Media container ── */
.ar-bento__media {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.ar-bento__img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform .45s cubic-bezier(.25,.46,.45,.94);
  transform: translateZ(0);
  will-change: transform;
}

.ar-bento__card:hover .ar-bento__img,
.ar-bento__card:focus-visible .ar-bento__img {
  transform: scale(1.06) translateZ(0);
}

/* ── Gradient overlay ── */
.ar-bento__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.5) 0%, transparent 55%);
  pointer-events: none;
}

/* ── Label ── */
.ar-bento__label {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  font-size: clamp(16px, 1.4vw, 22px);
  font-weight: 600;
  letter-spacing: .02em;
  line-height: 1.25;
  text-shadow: 0 1px 4px rgba(0,0,0,.45);
  z-index: 1;
  pointer-events: none;
}

/* ── Tablet (750–1023) ── */
@media (max-width: 1023px) and (min-width: 750px) {
  .ar-bento__grid {
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: 2fr 1fr 1fr;
    max-height: none;
    height: 100vh;
    border-radius: 12px;
    gap: 6px;
    padding: 6px;
  }

  .ar-bento__card--1 { grid-column: 1 / 3; grid-row: 1 / 2; }
  .ar-bento__card--2 { grid-column: 3 / 4; grid-row: 1 / 3; }
  .ar-bento__card--3 { grid-column: 1 / 2; grid-row: 2 / 3; }
  .ar-bento__card--4 { grid-column: 2 / 3; grid-row: 2 / 3; }
  .ar-bento__card--5 { grid-column: 1 / 2; grid-row: 3 / 4; }
  .ar-bento__card--6 { grid-column: 2 / 4; grid-row: 3 / 4; }
}

/* ── Mobile (<750) ── */
@media (max-width: 749px) {
  .ar-bento__grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 2fr 1fr 1fr 1.5fr;
    height: 100vh;
    height: 100svh;
    max-height: none;
    gap: 4px;
    padding: 4px;
    border-radius: 10px;
  }

  .ar-bento__card--1 { grid-column: 1 / 3; grid-row: 1 / 2; }
  .ar-bento__card--2 { grid-column: 2 / 3; grid-row: 2 / 4; }
  .ar-bento__card--3 { grid-column: 1 / 2; grid-row: 2 / 3; }
  .ar-bento__card--4 { grid-column: 1 / 2; grid-row: 3 / 4; }
  .ar-bento__card--5 { grid-column: 1 / 2; grid-row: 4 / 5; }
  .ar-bento__card--6 { grid-column: 2 / 3; grid-row: 4 / 5; }

  .ar-bento__card { border-radius: 8px; }

  .ar-bento__label {
    font-size: 14px;
    bottom: 12px;
    left: 12px;
    right: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ar-bento__card:hover .ar-bento__img,
  .ar-bento__card:focus-visible .ar-bento__img {
    transform: none;
  }
}
</style>
