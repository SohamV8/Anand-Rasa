{%- comment -%}
  Bento grid — 7 collection cards.
  Zodiac · Planet · Perfume · Incense · Gift · Apsara · Bestseller
{%- endcomment -%}
{%- liquid
  assign ar_bg_handles  = 'zodiac-attars|planet-attars|perfume-series|incense-sticks|giftsets|apsara-attars|bestseller' | split: '|'
  assign ar_bg_titles   = 'Zodiac Attars|Planet Attars|Perfume Series|Incense Sticks|Gift Sets|Apsara Attars|Bestsellers' | split: '|'
  assign ar_bg_descs    = 'Written in the stars. Worn on your skin.|Ancient planets. Modern rituals.|Where tradition meets the everyday.|Sacred smoke for stillness and clarity.|The art of giving, perfected.|Divinely crafted. Unapologetically bold.|The ones everyone reaches for.' | split: '|'
  assign ar_bg_images   = 'zodiac_home.webp|planet_home.webp|perfume_home.webp|Aggarbatti_home.webp|gift_home.webp|apsara_home.webp|bestseller_home.webp' | split: '|'
  assign ar_bg_matches  = 'zodiac|planet|perfume|incense|gift set|apsara|bestseller' | split: '|'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<section class="ar-bento" aria-label="Explore Collections">
  <div class="ar-bento__grid">
    {%- for handle in ar_bg_handles -%}
      {%- liquid
        assign idx = forloop.index0
        assign title = ar_bg_titles[idx]
        assign desc = ar_bg_descs[idx]
        assign fallback = ar_bg_images[idx]
        assign match_key = ar_bg_matches[idx]

        assign card_img = blank
        for block in section.blocks
          if block.type == 'category'
            assign bt = block.settings.title | downcase
            if bt contains match_key
              if block.settings.image != blank
                assign card_img = block.settings.image
              endif
              break
            endif
          endif
        endfor

        capture card_url
          render 'ar-collection-url', handle: handle
        endcapture
        assign card_url = card_url | strip
        if card_url == blank
          assign card_url = '/collections/' | append: handle
        endif
      -%}

      <a href="{{ card_url }}"
         class="ar-bento__card ar-bento__card--{{ forloop.index }}"
         aria-label="{{ title | escape }}">
        <div class="ar-bento__media">
          {%- if card_img != blank -%}
            <img
              class="ar-bento__img"
              src="{{ card_img | image_url: width: 800 }}"
              srcset="{{ card_img | image_url: width: 400 }} 400w, {{ card_img | image_url: width: 600 }} 600w, {{ card_img | image_url: width: 800 }} 800w"
              sizes="(min-width: 768px) 33vw, 80vw"
              alt="{{ title | escape }}"
              loading="lazy"
              decoding="async"
              width="800"
              height="600"
            >
          {%- else -%}
            <img
              class="ar-bento__img"
              src="{{ fallback | asset_url }}"
              alt="{{ title | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </div>
        <div class="ar-bento__text">
          <span class="ar-bento__eyebrow">{{ title | escape }}</span>
          <h3 class="ar-bento__title">{{ desc }}</h3>
          <span class="ar-bento__cta" aria-hidden="true">
            Explore
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
/* ── Bento: Minimal Brutalist Editorial ── */

.ar-bento {
  width: 100%;
  margin: 0;
  padding: 60px 32px;
  background: #fff;
  box-sizing: border-box;
}

.ar-bento__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: 280px 220px 260px;
  width: 1400px;
  max-width: 100%;
  gap: 14px;
  margin: 0 auto;
  box-sizing: border-box;
}

.ar-bento__card--1 { grid-column: 1 / 3; grid-row: 1 / 2; }
.ar-bento__card--2 { grid-column: 3 / 5; grid-row: 1 / 2; }
.ar-bento__card--3 { grid-column: 1 / 2; grid-row: 2 / 4; }
.ar-bento__card--4 { grid-column: 2 / 3; grid-row: 2 / 3; }
.ar-bento__card--5 { grid-column: 3 / 5; grid-row: 2 / 3; }
.ar-bento__card--6 { grid-column: 2 / 3; grid-row: 3 / 4; }
.ar-bento__card--7 { grid-column: 3 / 5; grid-row: 3 / 4; }

/* ── Card base ── */
.ar-bento__card {
  position: relative;
  display: flex;
  overflow: hidden;
  border-radius: 14px;
  background: #fff;
  border: 1px solid #eae8e4;
  box-shadow: none;
  text-decoration: none;
  color: #111;
  -webkit-tap-highlight-color: transparent;
  outline-offset: 3px;
  box-sizing: border-box;
  transition: border-color .3s ease;
}

.ar-bento__card:hover {
  border-color: #ccc;
}

.ar-bento__card:focus-visible {
  outline: 2px solid #111;
}

/* ── Flex per card ── */
.ar-bento__card--1 { flex-direction: row; }
.ar-bento__card--1 .ar-bento__media { flex: 0 0 50%; }
.ar-bento__card--1 .ar-bento__text  { flex: 0 0 50%; }

.ar-bento__card--2 { flex-direction: row; }
.ar-bento__card--2 .ar-bento__media { order: 2; flex: 0 0 55%; }
.ar-bento__card--2 .ar-bento__text  { order: 1; flex: 0 0 45%; }

.ar-bento__card--3 { flex-direction: column; }
.ar-bento__card--3 .ar-bento__media { flex: 1.5; }
.ar-bento__card--3 .ar-bento__text  { flex: 1; }

.ar-bento__card--4 { flex-direction: row; }
.ar-bento__card--4 .ar-bento__media { order: 2; }
.ar-bento__card--4 .ar-bento__text  { order: 1; }
.ar-bento__card--4 .ar-bento__title { font-size: clamp(15px, 1.4vw, 20px); }
.ar-bento__card--4 .ar-bento__desc { font-size: 12px; }

.ar-bento__card--5 { flex-direction: row; }
.ar-bento__card--5 .ar-bento__media { order: 2; flex: 0 0 55%; }
.ar-bento__card--5 .ar-bento__text  { order: 1; flex: 0 0 45%; }

.ar-bento__card--6 { flex-direction: row; }
.ar-bento__card--6 .ar-bento__media { flex: 0 0 50%; }
.ar-bento__card--6 .ar-bento__text  { flex: 0 0 50%; }

.ar-bento__card--7 { flex-direction: row; }
.ar-bento__card--7 .ar-bento__media { flex: 0 0 55%; }
.ar-bento__card--7 .ar-bento__text  { flex: 0 0 45%; }

/* ── Media ── */
.ar-bento__media {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  min-width: 0;
  min-height: 0;
  background: #fff;
  padding: 12px;
}

.ar-bento__img {
  display: block;
  max-width: 98%;
  max-height: 98%;
  width: auto;
  height: auto;
  object-fit: contain;
  object-position: center;
  transition: transform .5s cubic-bezier(.16,1,.3,1);
  will-change: transform;
}

.ar-bento__card:hover .ar-bento__img {
  transform: scale(1.04);
}

/* ── Text ── */
.ar-bento__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24px 24px;
  min-width: 0;
  gap: 0;
}

.ar-bento__eyebrow {
  display: block;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #999;
  margin-bottom: 10px;
  transition: color .3s ease;
}

.ar-bento__card:hover .ar-bento__eyebrow {
  color: #111;
}

.ar-bento__title {
  font-family: 'DM Serif Display', Georgia, serif;
  font-size: clamp(18px, 1.8vw, 28px);
  font-weight: 400;
  font-style: italic;
  line-height: 1.2;
  margin: 0 0 14px;
  color: #111;
  letter-spacing: -0.01em;
}

.ar-bento__cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #111;
  opacity: 0;
  transform: translate3d(-8px, 0, 0);
  transition:
    opacity .35s cubic-bezier(.16,1,.3,1),
    transform .35s cubic-bezier(.16,1,.3,1);
}

.ar-bento__cta svg {
  transition: transform .3s cubic-bezier(.16,1,.3,1);
}

.ar-bento__card:hover .ar-bento__cta {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}

.ar-bento__card:hover .ar-bento__cta svg {
  transform: translate3d(3px, 0, 0);
}

/* ── Tablet ── */
@media (max-width: 1023px) and (min-width: 750px) {
  .ar-bento { padding: 40px 20px; }

  .ar-bento__grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    gap: 14px;
  }

  .ar-bento__card--1 { grid-column: 1 / 3; }
  .ar-bento__card--2 { grid-column: 1 / 3; }
  .ar-bento__card--3 { grid-column: 1 / 2; }
  .ar-bento__card--4 { grid-column: 2 / 3; }
  .ar-bento__card--5 { grid-column: 1 / 2; }
  .ar-bento__card--6 { grid-column: 2 / 3; }
  .ar-bento__card--7 { grid-column: 1 / 3; }

  .ar-bento__card--1,
  .ar-bento__card--2,
  .ar-bento__card--3,
  .ar-bento__card--4,
  .ar-bento__card--5,
  .ar-bento__card--6,
  .ar-bento__card--7 { grid-row: auto; }

  .ar-bento__card--3,
  .ar-bento__card--4,
  .ar-bento__card--5,
  .ar-bento__card--6 { flex-direction: column; }

  .ar-bento__card--3 .ar-bento__media,
  .ar-bento__card--3 .ar-bento__text,
  .ar-bento__card--4 .ar-bento__media,
  .ar-bento__card--4 .ar-bento__text,
  .ar-bento__card--5 .ar-bento__media,
  .ar-bento__card--5 .ar-bento__text,
  .ar-bento__card--6 .ar-bento__media,
  .ar-bento__card--6 .ar-bento__text {
    order: unset;
    flex: unset;
  }

  .ar-bento__media { min-height: 200px; }
  .ar-bento__text { padding: 24px; }
  .ar-bento__cta { opacity: 1; transform: none; }
  .ar-bento__card { border-radius: 14px; }
}

/* ── Mobile ── */
@media (max-width: 749px) {
  .ar-bento { padding: 24px 14px; }

  .ar-bento__grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    gap: 12px;
  }

  .ar-bento__card--1,
  .ar-bento__card--2,
  .ar-bento__card--3,
  .ar-bento__card--4,
  .ar-bento__card--5,
  .ar-bento__card--6,
  .ar-bento__card--7 {
    grid-column: 1 / -1;
    grid-row: auto;
    flex-direction: column;
  }

  .ar-bento__card--1 .ar-bento__media,
  .ar-bento__card--1 .ar-bento__text,
  .ar-bento__card--2 .ar-bento__media,
  .ar-bento__card--2 .ar-bento__text,
  .ar-bento__card--3 .ar-bento__media,
  .ar-bento__card--3 .ar-bento__text,
  .ar-bento__card--4 .ar-bento__media,
  .ar-bento__card--4 .ar-bento__text,
  .ar-bento__card--5 .ar-bento__media,
  .ar-bento__card--5 .ar-bento__text,
  .ar-bento__card--6 .ar-bento__media,
  .ar-bento__card--6 .ar-bento__text,
  .ar-bento__card--7 .ar-bento__media,
  .ar-bento__card--7 .ar-bento__text {
    order: unset;
    flex: unset;
  }

  .ar-bento__media {
    min-height: 220px;
    max-height: 280px;
    padding: 12px;
  }

  .ar-bento__text { padding: 22px 18px 20px; }

  .ar-bento__eyebrow { font-size: 9px; margin-bottom: 8px; }

  .ar-bento__title { font-size: 20px; margin-bottom: 10px; }

  .ar-bento__cta {
    opacity: 1;
    transform: none;
    font-size: 10px;
  }

  .ar-bento__card { border-radius: 14px; }
}

@media (prefers-reduced-motion: reduce) {
  .ar-bento__card:hover .ar-bento__img { transform: none; }
  .ar-bento__cta { opacity: 1; transform: none; transition: none; }
  .ar-bento__cta svg { transition: none; }
  .ar-bento__eyebrow { transition: none; }
}
</style>
