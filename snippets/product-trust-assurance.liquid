{%- comment -%}
  Product PDP — luxury trust + assurance strip
{%- endcomment -%}
<div class="ar-trust-section" aria-label="Product assurance">
  <ul class="ar-trust-benefits" role="list">
    <li class="ar-trust-benefits__item">Free Shipping</li>
    <li class="ar-trust-benefits__item">100% Natural</li>
    <li class="ar-trust-benefits__item">Alcohol-Free</li>
    <li class="ar-trust-benefits__item">Hand-Distilled</li>
  </ul>

  <p class="ar-trust-gift">
    <span class="ar-trust-gift__icon" aria-hidden="true">🎁</span>
    <span class="ar-trust-gift__text">Gift-wrap available</span>
  </p>

  <div class="ar-guarantee-box">
    <p class="ar-guarantee-title">100% Ritual Satisfaction Guarantee</p>
    <p class="ar-guarantee-subtitle">
      <span class="ar-guarantee-subtitle__part">Order by 6 PM</span>
      <span class="ar-guarantee-subtitle__dot" aria-hidden="true"></span>
      <span class="ar-guarantee-subtitle__part">Delivered in 3–5 days</span>
    </p>
  </div>
</div>

<style>
  .ar-trust-section {
    --ar-trust-gold: #c8a96e;
    --ar-trust-ink: #4a3f32;
    --ar-trust-muted: #7a6b58;
    --ar-trust-ivory: #faf8f4;
    --ar-trust-line: rgba(200, 169, 110, 0.4);
    margin: 22px 0 18px;
    padding: 0 2px;
    text-align: center;
    animation: ar-trust-in 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes ar-trust-in {
    from {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .ar-trust-benefits {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .ar-trust-benefits__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 12px;
    margin: 0;
    box-sizing: border-box;
    border: 1px solid rgba(200, 169, 110, 0.28);
    border-radius: 10px;
    background: #fff;
    font-family: 'Poppins', var(--font-heading-family, sans-serif);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ar-trust-ink);
    line-height: 1.25;
    text-align: center;
  }

  .ar-trust-gift {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(200, 169, 110, 0.1);
    font-family: 'Poppins', var(--font-heading-family, sans-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ar-trust-muted);
    line-height: 1.3;
  }

  .ar-trust-gift__icon {
    font-size: 18px;
    line-height: 1;
    opacity: 0.95;
  }

  .ar-guarantee-box {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 18px 16px;
    box-sizing: border-box;
    background: var(--ar-trust-ivory);
    border: 1px solid var(--ar-trust-line);
    border-radius: 12px;
    box-shadow: 0 6px 24px rgba(92, 79, 63, 0.06);
    transition:
      box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ar-guarantee-title {
    margin: 0 0 10px;
    font-family: 'Poppins', var(--font-heading-family, sans-serif);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.35;
    color: var(--ar-trust-ink);
  }

  .ar-guarantee-subtitle {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 10px;
    margin: 0;
    font-family: 'Caudex', var(--font-body-family, Georgia, serif);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.45;
    color: var(--ar-trust-muted);
  }

  .ar-guarantee-subtitle__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ar-trust-gold);
    flex-shrink: 0;
    opacity: 0.85;
  }

  /* Tablet+ — quieter editorial strip (2 rows) */
  @media screen and (min-width: 750px) {
    .ar-trust-section {
      margin: clamp(18px, 3vw, 28px) 0 clamp(14px, 2.5vw, 22px);
      padding: 0;
    }

    .ar-trust-benefits {
      display: grid;
      grid-template-columns: repeat(2, auto);
      justify-content: center;
      column-gap: 0;
      row-gap: 10px;
      margin-bottom: 14px;
    }

    .ar-trust-benefits__item {
      min-height: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      justify-content: flex-end;
    }

    .ar-trust-benefits__item:nth-child(even) {
      justify-content: flex-start;
    }

    .ar-trust-benefits__item:nth-child(odd)::after {
      content: '';
      display: inline-block;
      width: 3px;
      height: 3px;
      margin: 0 18px;
      border-radius: 50%;
      background: var(--ar-trust-gold);
      opacity: 0.75;
      flex-shrink: 0;
    }

    .ar-trust-gift {
      margin-bottom: 20px;
      padding: 0;
      background: transparent;
      font-size: 11px;
      letter-spacing: 0.12em;
    }

    .ar-trust-gift__icon {
      font-size: 14px;
    }

    .ar-guarantee-box {
      max-width: 420px;
      padding: 20px 28px;
    }

    .ar-guarantee-box:hover {
      border-color: rgba(200, 169, 110, 0.58);
      box-shadow: 0 10px 36px rgba(200, 169, 110, 0.12);
    }

    .ar-guarantee-title {
      font-size: 14.5px;
      margin-bottom: 8px;
    }

    .ar-guarantee-subtitle {
      font-size: 13px;
      gap: 10px 12px;
    }
  }

  @media screen and (max-width: 359px) {
    .ar-trust-benefits {
      gap: 8px;
    }

    .ar-trust-benefits__item {
      font-size: 11.5px;
      padding: 10px 8px;
      letter-spacing: 0.03em;
    }

    .ar-guarantee-title {
      font-size: 14px;
    }

    .ar-guarantee-subtitle {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ar-trust-section {
      animation: none;
    }

    .ar-guarantee-box {
      transition: none;
    }
  }
</style>
