{%- comment -%}
  Canonical FAQ path or absolute URL.
  Prefer the published FAQ page (handles vary by store history).
  Usage: {% render 'ar-faq-url' %} or {% render 'ar-faq-url', absolute: true %}
{%- endcomment -%}
{%- liquid
  assign ar_faq_url = pages['faq'].url
  if ar_faq_url == blank
    assign ar_faq_url = pages['faqs'].url
  endif
  if ar_faq_url == blank
    assign ar_faq_url = pages['frequently-asked-questions'].url
  endif
  if ar_faq_url == blank
    assign ar_faq_url = pages['https-www-anandrasa-com-pages-frequently-asked-questions'].url
  endif
  if ar_faq_url == blank
    assign ar_faq_url = '/pages/https-www-anandrasa-com-pages-frequently-asked-questions'
  endif
-%}
{%- if absolute -%}
  {{- request.origin | append: ar_faq_url -}}
{%- else -%}
  {{- ar_faq_url -}}
{%- endif -%}
