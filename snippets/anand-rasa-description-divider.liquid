{%- comment -%}
  Anand Rasa — Refined Gold Ornamental Divider
  Single luxury-gold tapered lines + centered ornament.
  Lightweight CSS-only animation.
{%- endcomment -%}

<div
  class="anand-rasa-product-description__divider"
  aria-hidden="true"
>
  <!-- LEFT GOLD LINE -->
  <span
    class="anand-rasa-product-description__divider-line
           anand-rasa-product-description__divider-line--left"
  ></span>

  <!-- CENTER ORNAMENT -->
  <svg
    class="anand-rasa-product-description__divider-ornament"
    viewBox="0 0 44 44"
    xmlns="http://www.w3.org/2000/svg"
    role="presentation"
    focusable="false"
  >
    <g fill="#C8A04A">

      <!-- TOP PETAL -->
      <path
        d="
          M22 3
          C17.8 6.2 16.1 10.4 18.1 14.3
          C19.1 16.3 20.6 18 22 19
          C23.4 18 24.9 16.3 25.9 14.3
          C27.9 10.4 26.2 6.2 22 3
          Z
        "
      />

      <!-- RIGHT PETAL -->
      <path
        d="
          M41 22
          C37.8 17.8 33.6 16.1 29.7 18.1
          C27.7 19.1 26 20.6 25 22
          C26 23.4 27.7 24.9 29.7 25.9
          C33.6 27.9 37.8 26.2 41 22
          Z
        "
      />

      <!-- BOTTOM PETAL -->
      <path
        d="
          M22 41
          C26.2 37.8 27.9 33.6 25.9 29.7
          C24.9 27.7 23.4 26 22 25
          C20.6 26 19.1 27.7 18.1 29.7
          C16.1 33.6 17.8 37.8 22 41
          Z
        "
      />

      <!-- LEFT PETAL -->
      <path
        d="
          M3 22
          C6.2 26.2 10.4 27.9 14.3 25.9
          C16.3 24.9 18 23.4 19 22
          C18 20.6 16.3 19.1 14.3 18.1
          C10.4 16.1 6.2 17.8 3 22
          Z
        "
      />

      <!-- CENTER -->
      <path
        d="
          M22 16
          L28 22
          L22 28
          L16 22
          Z
        "
      />

      <!-- SMALL BOTTOM TIP -->
      <path
        d="
          M22 28
          L24.6 31
          L22 34
          L19.4 31
          Z
        "
      />

    </g>
  </svg>

  <!-- RIGHT GOLD LINE -->
  <span
    class="anand-rasa-product-description__divider-line
           anand-rasa-product-description__divider-line--right"
  ></span>
</div>

<style>
  .anand-rasa-product-description__divider {
    --ar-gold: #c8a04a;

    width: 100%;
    height: 36px;
    margin: 24px 0;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;
    overflow: hidden;
    pointer-events: none;
    box-sizing: border-box;
  }

  /*
    SINGLE THIN GOLD LINE
    Visible at the ornament
    Softly fades toward the outer edge
  */
  .anand-rasa-product-description__divider-line {
    position: relative;

    flex: 1 1 auto;
    min-width: 0;
    height: 1px;

    display: block;
    overflow: hidden;

    background: linear-gradient(
      90deg,
      rgba(200, 160, 74, 0) 0%,
      rgba(200, 160, 74, 0.22) 12%,
      rgba(200, 160, 74, 0.58) 38%,
      rgba(200, 160, 74, 0.90) 72%,
      rgba(200, 160, 74, 1) 100%
    );

    transform: translateZ(0);
    will-change: opacity;
  }

  .anand-rasa-product-description__divider-line--right {
    background: linear-gradient(
      90deg,
      rgba(200, 160, 74, 1) 0%,
      rgba(200, 160, 74, 0.90) 28%,
      rgba(200, 160, 74, 0.58) 62%,
      rgba(200, 160, 74, 0.22) 88%,
      rgba(200, 160, 74, 0) 100%
    );
  }

  /*
    Very subtle luxury shimmer.
    Only opacity + transform are animated.
    No JS, no layout animation.
  */
  .anand-rasa-product-description__divider-line::after {
    content: "";
    position: absolute;
    top: 0;
    left: -20%;
    width: 18%;
    height: 100%;

    background: rgba(255, 255, 255, 0.45);

    transform: translate3d(-120%, 0, 0);
    animation: ar-divider-shimmer 5s ease-in-out infinite;

    pointer-events: none;
  }

  .anand-rasa-product-description__divider-line--right::after {
    animation-delay: 0.35s;
  }

  @keyframes ar-divider-shimmer {
    0%,
    65% {
      transform: translate3d(-120%, 0, 0);
      opacity: 0;
    }

    72% {
      opacity: 0.15;
    }

    88% {
      transform: translate3d(650%, 0, 0);
      opacity: 0.35;
    }

    100% {
      transform: translate3d(650%, 0, 0);
      opacity: 0;
    }
  }

  .anand-rasa-product-description__divider-ornament {
    display: block;
    flex: 0 0 24px;

    width: 24px;
    height: 24px;

    color: var(--ar-gold);

    shape-rendering: geometricPrecision;
    overflow: visible;

    transform: translateZ(0);
  }

  @media screen and (max-width: 749px) {
    .anand-rasa-product-description__divider {
      height: 28px;
      margin: 18px 0;
      gap: 6px;
    }

    .anand-rasa-product-description__divider-line {
      height: 1px;
    }

    .anand-rasa-product-description__divider-ornament {
      flex-basis: 20px;
      width: 20px;
      height: 20px;
    }
  }

  @media screen and (max-width: 480px) {
    .anand-rasa-product-description__divider {
      gap: 5px;
    }

    .anand-rasa-product-description__divider-ornament {
      flex-basis: 18px;
      width: 18px;
      height: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anand-rasa-product-description__divider-line::after {
      animation: none;
      display: none;
    }
  }
</style>