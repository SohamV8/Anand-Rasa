{%- comment -%}
  Perfume Series — collection card thumbnail lookup.
  Maps perfume products to theme assets on /collections/perfume-series only.
  Echoes asset filename or empty string (fallback to product featured image).
{%- endcomment -%}
{%- liquid
  assign ps_key = ps_product.handle | default: '' | downcase
  assign ps_title = ps_product.title | default: '' | downcase
  assign ps_img = ''

  if ps_key contains 'blue-glacier' or ps_title contains 'blue glacier'
    assign ps_img = 'blue-glacier_thumbnail.webp'
  elsif ps_key contains 'candy-blast' or ps_title contains 'candy blast'
    assign ps_img = 'candy-blast_thumbnail.webp'
  elsif ps_key contains 'choco-mocho' or ps_title contains 'choco mocho'
    assign ps_img = 'choco-mocho_thumbnail.webp'
  elsif ps_key contains 'dastaan' or ps_title contains 'dastaan'
    assign ps_img = 'dastaan_thumbnail.webp'
  elsif ps_key contains 'forbidden-fruit' or ps_title contains 'forbidden fruit'
    assign ps_img = 'forbidden-fruit_thumbnail.webp'
  elsif ps_key contains 'her-love' or ps_title contains 'her love'
    assign ps_img = 'her-love_thumbnail.webp'
  elsif ps_key contains 'love-potion' or ps_title contains 'love potion'
    assign ps_img = 'love-potion_thumbnail.webp'
  elsif ps_key contains 'vintage-vanilla' or ps_title contains 'vintage vanilla'
    assign ps_img = 'vintage-vanilla_thumbnail.webp'
  elsif ps_key == 'mirage' or ps_title == 'mirage'
    assign ps_img = 'mirage_thumbnail.webp'
  elsif ps_key contains 'office-time' or ps_title contains 'office time'
    assign ps_img = 'office-time_thumbnail.webp'
  elsif ps_key contains 'royal-passion' or ps_title contains 'royal passion'
    assign ps_img = 'royal-passion_thumbnail.webp'
  elsif ps_key contains 'baazigar' or ps_title contains 'baazigar'
    assign ps_img = 'baazigar_thumbnail.webp'
  endif

  echo ps_img
-%}
