{%- comment -%}
  Editorial attar story — italic intro, ✺ divider, factual detail.

  Content priority (server-rendered, product-specific):
  1. Product metafields (story / fragrance / emotional / signature / short / intro+detail)
  2. First storytelling paragraphs from product.description
  3. Generated from title + real notes / accords / collection context

  Usage: {% render 'attar-product-story', product: product, section: section %}
{%- endcomment -%}

{%- liquid
  assign aps_p = product
  if aps_p == blank
    assign aps_p = story_product
  endif
-%}

{%- if aps_p != blank -%}
  {%- capture aps_planet_titles -%}{%- render 'planet-product-titles-lookup', product: aps_p -%}{%- endcapture -%}
  {%- assign aps_planet_titles = aps_planet_titles | strip -%}

  {%- if aps_planet_titles contains '|||' -%}
    {%- assign aps_planet_parts = aps_planet_titles | split: '|||' -%}
    {%- assign aps_marketplace_text = aps_planet_parts[0] | strip | replace: ' 6ml', '' | replace: ' 6 ml', '' | strip -%}
    <div class="ar-story-block ar-story-block--planet" data-attar-story data-planet-titles>
      <p class="ar-story-marketplace">{{ aps_marketplace_text | escape }}</p>
      <div class="ar-divider ar-divider--planet" aria-hidden="true">
        <span>✺</span>
      </div>
      <p class="ar-story-shopify">{{ aps_planet_parts[1] | escape }}</p>
    </div>

    <style>
      .ar-story-block--planet {
        margin: clamp(10px, 2vw, 16px) 0 clamp(18px, 3vw, 28px);
        max-width: 52ch;
      }

      @keyframes ar-story-rise {
        from {
          opacity: 0;
          transform: translate3d(0, 14px, 0);
        }
        to {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
      }

      @keyframes ar-story-line {
        from {
          opacity: 0;
          transform: scaleX(0.35);
        }
        to {
          opacity: 1;
          transform: scaleX(1);
        }
      }

      .ar-story-block--planet .ar-story-marketplace {
        font-family: 'Jost', system-ui, sans-serif;
        font-size: clamp(13px, 1.05vw + 11px, 15px);
        font-weight: 400;
        line-height: 1.62;
        letter-spacing: 0.01em;
        color: #6b5a46;
        margin: 0;
        animation: ar-story-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) both;
        text-wrap: pretty;
      }

      .ar-story-block--planet .ar-divider--planet {
        position: relative;
        text-align: center;
        margin: clamp(10px, 2vw, 14px) 0;
        animation: ar-story-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
      }

      .ar-story-block--planet .ar-divider--planet::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        border-top: 1px solid #d8c08a;
        transform-origin: center;
        animation: ar-story-line 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
      }

      .ar-story-block--planet .ar-divider--planet span {
        position: relative;
        display: inline-block;
        background: #ffffff;
        padding: 0 10px;
        color: #c8a03a;
        font-size: clamp(11px, 0.8vw + 9px, 13px);
        line-height: 1;
      }

      .ar-story-block--planet .ar-story-shopify {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: clamp(16px, 1.2vw + 13px, 19px);
        font-weight: 500;
        font-style: italic;
        line-height: 1.5;
        letter-spacing: 0.01em;
        color: #7a654c;
        margin: 0;
        animation: ar-story-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
        text-wrap: pretty;
      }

      @media screen and (min-width: 990px) {
        .ar-story-block--planet {
          max-width: 46ch;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .ar-story-block--planet .ar-story-marketplace,
        .ar-story-block--planet .ar-divider--planet,
        .ar-story-block--planet .ar-story-shopify,
        .ar-story-block--planet .ar-divider--planet::before {
          animation: none;
        }
      }
    </style>
  {%- else -%}
  {%- liquid
    assign aps_intro = ''
    assign aps_body = ''
  -%}
  {%- capture aps_bs_lookup -%}
    {%- render 'bestseller-attar-story-lookup', product: aps_p -%}
  {%- endcapture -%}
  {%- assign aps_bs_lookup = aps_bs_lookup | strip -%}
  {%- if aps_bs_lookup contains '~|~' -%}
    {%- assign aps_bs_parts = aps_bs_lookup | split: '~|~' -%}
    {%- assign aps_intro = aps_bs_parts[0] | strip -%}
    {%- assign aps_body = aps_bs_parts[1] | strip -%}
  {%- else -%}
  {%- capture aps_ps_lookup -%}
    {%- render 'perfume-series-story-lookup', product: aps_p -%}
  {%- endcapture -%}
  {%- assign aps_ps_lookup = aps_ps_lookup | strip -%}
  {%- if aps_ps_lookup contains '~|~' -%}
    {%- assign aps_ps_parts = aps_ps_lookup | split: '~|~' -%}
    {%- assign aps_intro = aps_ps_parts[0] | strip -%}
    {%- assign aps_body = aps_ps_parts[1] | strip -%}
  {%- else -%}
  {%- liquid
    assign aps_mf_story = aps_p.metafields.custom.story | metafield_text | strip
    if aps_mf_story == blank and aps_p.metafields.custom.story != blank
      assign aps_mf_story = aps_p.metafields.custom.story.value | default: aps_p.metafields.custom.story | strip_html | strip
    endif

    assign aps_mf_fragrance = aps_p.metafields.custom.fragrance_story | metafield_text | strip
    if aps_mf_fragrance == blank and aps_p.metafields.custom.fragrance_story != blank
      assign aps_mf_fragrance = aps_p.metafields.custom.fragrance_story.value | default: aps_p.metafields.custom.fragrance_story | strip_html | strip
    endif

    assign aps_mf_emotional = aps_p.metafields.custom.emotional_story | metafield_text | strip
    if aps_mf_emotional == blank and aps_p.metafields.custom.emotional_story != blank
      assign aps_mf_emotional = aps_p.metafields.custom.emotional_story.value | default: aps_p.metafields.custom.emotional_story | strip_html | strip
    endif

    assign aps_mf_signature = aps_p.metafields.custom.signature_story | metafield_text | strip
    if aps_mf_signature == blank and aps_p.metafields.custom.signature_story != blank
      assign aps_mf_signature = aps_p.metafields.custom.signature_story.value | default: aps_p.metafields.custom.signature_story | strip_html | strip
    endif

    assign aps_mf_meaning = aps_p.metafields.custom.meaning_story | metafield_text | strip
    if aps_mf_meaning == blank and aps_p.metafields.custom.meaning_story != blank
      assign aps_mf_meaning = aps_p.metafields.custom.meaning_story.value | default: aps_p.metafields.custom.meaning_story | strip_html | strip
    endif

    assign aps_mf_short = aps_p.metafields.custom.short_story | metafield_text | strip
    if aps_mf_short == blank and aps_p.metafields.custom.short_story != blank
      assign aps_mf_short = aps_p.metafields.custom.short_story.value | default: aps_p.metafields.custom.short_story | strip_html | strip
    endif

    assign aps_mf_intro = aps_p.metafields.custom.story_intro | metafield_text | strip
    if aps_mf_intro == blank and aps_p.metafields.custom.story_intro != blank
      assign aps_mf_intro = aps_p.metafields.custom.story_intro.value | default: aps_p.metafields.custom.story_intro | strip_html | strip
    endif

    assign aps_mf_detail = aps_p.metafields.custom.story_detail | metafield_text | strip
    if aps_mf_detail == blank and aps_p.metafields.custom.story_detail != blank
      assign aps_mf_detail = aps_p.metafields.custom.story_detail.value | default: aps_p.metafields.custom.story_detail | strip_html | strip
    endif

    assign aps_tagline = aps_p.metafields.custom.tagline | metafield_text | strip
    if aps_tagline == blank and aps_p.metafields.custom.tagline != blank
      assign aps_tagline = aps_p.metafields.custom.tagline.value | default: aps_p.metafields.custom.tagline | strip_html | strip
    endif

    comment
      Prefer the most complete story metafield among story-family keys.
    endcomment
    assign aps_story_blob = ''
    assign aps_story_len = 0

    if aps_mf_story != blank
      assign aps_story_blob = aps_mf_story
      assign aps_story_len = aps_mf_story.size
    endif
    if aps_mf_fragrance != blank and aps_mf_fragrance.size > aps_story_len
      assign aps_story_blob = aps_mf_fragrance
      assign aps_story_len = aps_mf_fragrance.size
    endif
    if aps_mf_emotional != blank and aps_mf_emotional.size > aps_story_len
      assign aps_story_blob = aps_mf_emotional
      assign aps_story_len = aps_mf_emotional.size
    endif
    if aps_mf_signature != blank and aps_mf_signature.size > aps_story_len
      assign aps_story_blob = aps_mf_signature
      assign aps_story_len = aps_mf_signature.size
    endif
    if aps_mf_meaning != blank and aps_mf_meaning.size > aps_story_len
      assign aps_story_blob = aps_mf_meaning
      assign aps_story_len = aps_mf_meaning.size
    endif

    comment
      Explicit priority: custom.story → short_story when no longer story-family field won via completeness.
      If custom.story exists it always wins over short alone.
    endcomment
    if aps_mf_story != blank
      assign aps_story_blob = aps_mf_story
    elsif aps_story_blob == blank and aps_mf_short != blank
      assign aps_story_blob = aps_mf_short
    endif

    if aps_mf_intro != blank
      assign aps_intro = aps_mf_intro
    endif
    if aps_mf_detail != blank
      assign aps_body = aps_mf_detail
    endif

    if aps_intro == blank and aps_body == blank and aps_story_blob != blank
      assign aps_split_a = ''
      assign aps_split_b = ''
      assign aps_br = aps_story_blob | newline_to_br | split: '<br />'
      if aps_br.size < 2
        assign aps_br = aps_story_blob | newline_to_br | split: '<br/>'
      endif
      if aps_br.size < 2
        assign aps_br = aps_story_blob | newline_to_br | split: '<br>'
      endif

      for aps_line in aps_br
        assign aps_line_clean = aps_line | strip_html | strip
        if aps_line_clean != blank
          if aps_split_a == blank
            assign aps_split_a = aps_line_clean
          elsif aps_split_b == blank
            assign aps_split_b = aps_line_clean
          else
            assign aps_split_b = aps_split_b | append: ' ' | append: aps_line_clean
          endif
        endif
      endfor

      if aps_split_b == blank and aps_story_blob contains '. '
        assign aps_dot_parts = aps_story_blob | split: '. '
        if aps_dot_parts.size > 1
          assign aps_split_a = aps_dot_parts.first | append: '.'
          assign aps_split_b = ''
          for aps_dot_part in aps_dot_parts
            unless forloop.first
              if aps_split_b != blank
                assign aps_split_b = aps_split_b | append: '. '
              endif
              assign aps_split_b = aps_split_b | append: aps_dot_part
            endunless
          endfor
          assign aps_split_b = aps_split_b | strip
        endif
      endif

      if aps_split_a != blank
        assign aps_intro = aps_split_a
      else
        assign aps_intro = aps_story_blob
      endif
      if aps_split_b != blank
        assign aps_body = aps_split_b
      endif
    elsif aps_intro == blank and aps_story_blob != blank
      assign aps_intro = aps_story_blob
    endif

    comment
      Priority 2 — product description paragraphs
    endcomment
    if aps_intro == blank or aps_body == blank
      assign aps_desc_html = aps_p.description | default: ''
      if aps_desc_html != blank
        assign aps_desc_parts = aps_desc_html | split: '</p>'
        assign aps_desc_first = ''
        assign aps_desc_second = ''
        for aps_part in aps_desc_parts
          assign aps_para = aps_part | strip_html | strip
          if aps_para.size >= 28
            assign aps_para_down = aps_para | downcase
            unless aps_para_down contains 'top notes' or aps_para_down contains 'heart notes' or aps_para_down contains 'base notes' or aps_para_down contains 'middle notes'
              if aps_desc_first == blank
                assign aps_desc_first = aps_para
              elsif aps_desc_second == blank
                assign aps_desc_second = aps_para
              endif
            endunless
          endif
        endfor

        if aps_desc_first == blank
          assign aps_desc_plain = aps_desc_html | strip_html | strip
          if aps_desc_plain.size >= 28
            assign aps_desc_first = aps_desc_plain | truncate: 220, ''
            if aps_desc_plain.size > 220
              assign aps_rest = aps_desc_plain | slice: 220, 280 | strip
              if aps_rest != blank
                assign aps_desc_second = aps_rest | truncate: 220, ''
              endif
            endif
          endif
        endif

        if aps_intro == blank and aps_desc_first != blank
          assign aps_intro = aps_desc_first
        endif
      endif
    endif

    if aps_intro == blank and aps_tagline != blank
      assign aps_intro = aps_tagline
    endif
  -%}

  {%- comment -%} Real fragrance data for factual body / generated fallbacks {%- endcomment -%}
  {%- capture aps_top -%}
    {%- render 'fragrance-notes-normalize', notes: aps_p.metafields.custom.top_notes.value, notes_type: aps_p.metafields.custom.top_notes.type -%}
  {%- endcapture -%}
  {%- capture aps_heart -%}
    {%- render 'fragrance-notes-normalize', notes: aps_p.metafields.custom.heart_notes.value, notes_type: aps_p.metafields.custom.heart_notes.type -%}
  {%- endcapture -%}
  {%- capture aps_middle -%}
    {%- render 'fragrance-notes-normalize', notes: aps_p.metafields.custom.middle_notes.value, notes_type: aps_p.metafields.custom.middle_notes.type -%}
  {%- endcapture -%}
  {%- capture aps_base -%}
    {%- render 'fragrance-notes-normalize', notes: aps_p.metafields.custom.base_notes.value, notes_type: aps_p.metafields.custom.base_notes.type -%}
  {%- endcapture -%}
  {%- capture aps_main -%}
    {%- render 'fragrance-notes-normalize', notes: aps_p.metafields.custom.main_notes.value, notes_type: aps_p.metafields.custom.main_notes.type -%}
  {%- endcapture -%}

  {%- liquid
    assign aps_top = aps_top | strip
    assign aps_heart = aps_heart | strip
    assign aps_middle = aps_middle | strip
    assign aps_base = aps_base | strip
    assign aps_main = aps_main | strip

    assign aps_desc_html_raw = aps_p.description | default: ''
  -%}
  {%- capture aps_desc_html_notes -%}
    {%- render 'fragrance-notes-normalize-headings', text: aps_desc_html_raw -%}
  {%- endcapture -%}
  {%- liquid
    assign aps_desc_html_notes = aps_desc_html_notes | strip
    assign aps_desc_notes = aps_desc_html_notes | strip_html | strip
  -%}
  {%- capture aps_desc_notes -%}
    {%- render 'fragrance-notes-normalize-headings', text: aps_desc_notes -%}
  {%- endcapture -%}
  {%- liquid
    assign aps_desc_notes = aps_desc_notes | strip

    if aps_top == blank and aps_desc_html_notes contains 'Top Notes'
      assign aps_top_section = aps_desc_html_notes | split: 'Top Notes' | last | split: 'Middle Notes' | first | split: 'Heart Notes' | first | split: 'Base Notes' | first
      capture aps_top
        render 'fragrance-notes-normalize', notes: aps_top_section
      endcapture
      assign aps_top = aps_top | strip
    elsif aps_top == blank and aps_desc_notes contains 'Top Notes'
      assign aps_top_chunks = aps_desc_notes | split: 'Top Notes'
      if aps_top_chunks.size > 1
        assign aps_top_raw = aps_top_chunks[1] | split: 'Middle Notes' | first | split: 'Heart Notes' | first | split: 'Base Notes' | first
        assign aps_top_parts = aps_top_raw | split: ':'
        if aps_top_parts.size > 1
          assign aps_top_extract = aps_top_parts[1] | strip
        else
          assign aps_top_extract = aps_top_raw | replace: ':', '' | strip
        endif
        capture aps_top
          render 'fragrance-notes-normalize', notes: aps_top_extract
        endcapture
        assign aps_top = aps_top | strip
      endif
    endif

    if aps_heart == blank and aps_desc_html_notes contains 'Middle Notes'
      assign aps_heart_section = aps_desc_html_notes | split: 'Middle Notes' | last | split: 'Heart Notes' | first | split: 'Base Notes' | first
      capture aps_heart
        render 'fragrance-notes-normalize', notes: aps_heart_section
      endcapture
      assign aps_heart = aps_heart | strip
    elsif aps_heart == blank and aps_desc_notes contains 'Middle Notes'
      assign aps_heart_chunks = aps_desc_notes | split: 'Middle Notes'
      if aps_heart_chunks.size > 1
        assign aps_heart_raw = aps_heart_chunks[1] | split: 'Heart Notes' | first | split: 'Base Notes' | first
        assign aps_heart_parts = aps_heart_raw | split: ':'
        if aps_heart_parts.size > 1
          assign aps_heart_extract = aps_heart_parts[1] | strip
        else
          assign aps_heart_extract = aps_heart_raw | replace: ':', '' | strip
        endif
        capture aps_heart
          render 'fragrance-notes-normalize', notes: aps_heart_extract
        endcapture
        assign aps_heart = aps_heart | strip
      endif
    endif

    if aps_heart == blank and aps_desc_html_notes contains 'Heart Notes'
      assign aps_heart_section = aps_desc_html_notes | split: 'Heart Notes' | last | split: 'Middle Notes' | first | split: 'Base Notes' | first
      capture aps_heart
        render 'fragrance-notes-normalize', notes: aps_heart_section
      endcapture
      assign aps_heart = aps_heart | strip
    elsif aps_heart == blank and aps_desc_notes contains 'Heart Notes'
      assign aps_heart_chunks = aps_desc_notes | split: 'Heart Notes'
      if aps_heart_chunks.size > 1
        assign aps_heart_raw = aps_heart_chunks[1] | split: 'Middle Notes' | first | split: 'Base Notes' | first
        assign aps_heart_parts = aps_heart_raw | split: ':'
        if aps_heart_parts.size > 1
          assign aps_heart_extract = aps_heart_parts[1] | strip
        else
          assign aps_heart_extract = aps_heart_raw | replace: ':', '' | strip
        endif
        capture aps_heart
          render 'fragrance-notes-normalize', notes: aps_heart_extract
        endcapture
        assign aps_heart = aps_heart | strip
      endif
    endif

    if aps_base == blank and aps_desc_html_notes contains 'Base Notes'
      assign aps_base_section = aps_desc_html_notes | split: 'Base Notes' | last
      capture aps_base
        render 'fragrance-notes-normalize', notes: aps_base_section
      endcapture
      assign aps_base = aps_base | strip
    elsif aps_base == blank and aps_desc_notes contains 'Base Notes'
      assign aps_base_chunks = aps_desc_notes | split: 'Base Notes'
      if aps_base_chunks.size > 1
        assign aps_base_raw = aps_base_chunks[1]
        assign aps_base_parts = aps_base_raw | split: ':'
        if aps_base_parts.size > 1
          assign aps_base_extract = aps_base_parts[1] | strip
        else
          assign aps_base_extract = aps_base_raw | replace: ':', '' | strip
        endif
        capture aps_base
          render 'fragrance-notes-normalize', notes: aps_base_extract
        endcapture
        assign aps_base = aps_base | strip
      endif
    endif

    comment
      Heart Notes and Middle Notes are the same tier — coalesce + dedupe (never double-list).
    endcomment
  -%}
  {%- capture aps_heart -%}
    {%- render 'fragrance-notes-merge', notes_a: aps_heart, notes_b: aps_middle -%}
  {%- endcapture -%}
  {%- liquid
    assign aps_heart = aps_heart | strip
    assign aps_middle = aps_heart
  -%}
  {%- if aps_heart != blank and aps_top != blank -%}
    {%- capture aps_top -%}{%- render 'fragrance-notes-subtract', source_notes: aps_top, remove_notes: aps_heart -%}{%- endcapture -%}
    {%- assign aps_top = aps_top | strip -%}
  {%- endif -%}
  {%- if aps_base != blank and aps_heart != blank -%}
    {%- capture aps_heart -%}{%- render 'fragrance-notes-subtract', source_notes: aps_heart, remove_notes: aps_base -%}{%- endcapture -%}
    {%- assign aps_heart = aps_heart | strip -%}
    {%- assign aps_middle = aps_heart -%}
  {%- endif -%}
  {%- if aps_base != blank and aps_top != blank -%}
    {%- capture aps_top -%}{%- render 'fragrance-notes-subtract', source_notes: aps_top, remove_notes: aps_base -%}{%- endcapture -%}
    {%- assign aps_top = aps_top | strip -%}
  {%- endif -%}
  {%- liquid
    assign aps_ingredients = aps_p.metafields.custom.ingredients | metafield_text | strip
    if aps_ingredients == blank and aps_p.metafields.custom.ingredients != blank
      assign aps_ingredients = aps_p.metafields.custom.ingredients.value | default: '' | strip_html | strip
    endif

    assign aps_accords = aps_p.metafields.custom.accords | metafield_text | strip
    if aps_accords == blank and aps_p.metafields.custom.accords != blank
      assign aps_accords_val = aps_p.metafields.custom.accords.value
      if aps_accords_val.size > 0
        assign aps_accords = aps_accords_val | join: ', '
      else
        assign aps_accords = aps_accords_val | default: '' | strip_html | strip
      endif
    endif

    assign aps_family = aps_p.metafields.custom.fragrance_family | metafield_text | strip
    if aps_family == blank
      assign aps_family = aps_p.metafields.custom.fragrance_family.value | default: aps_p.metafields.custom.family.value | default: '' | strip
    endif

    assign aps_mood = aps_p.metafields.custom.mood | metafield_text | strip
    if aps_mood == blank
      assign aps_mood = aps_p.metafields.custom.mood.value | default: '' | strip
    endif

    assign aps_concentration = aps_p.metafields.custom.concentration | metafield_text | strip
    if aps_concentration == blank
      assign aps_concentration = aps_p.metafields.custom.concentration.value | default: '' | strip
    endif

    assign aps_planet = aps_p.metafields.custom.planet | metafield_text | strip
    if aps_planet == blank
      assign aps_planet = aps_p.metafields.custom.planet.value | default: '' | strip
    endif

    assign aps_zodiac = aps_p.metafields.custom.zodiac | metafield_text | strip
    if aps_zodiac == blank
      assign aps_zodiac = aps_p.metafields.custom.zodiac.value | default: aps_p.metafields.custom.rashi.value | default: '' | strip
    endif

    assign aps_nakshatra = aps_p.metafields.custom.nakshatra | metafield_text | strip
    if aps_nakshatra == blank
      assign aps_nakshatra = aps_p.metafields.custom.nakshatra.value | default: '' | strip
    endif

    assign aps_chakra = aps_p.metafields.custom.chakra | metafield_text | strip
    if aps_chakra == blank
      assign aps_chakra = aps_p.metafields.custom.chakra.value | default: '' | strip
    endif

    assign aps_collection_title = ''
    if aps_p.collections.size > 0
      assign aps_collection_title = aps_p.collections.first.title | strip
    endif

    assign aps_note_1 = ''
    assign aps_note_2 = ''
    if aps_top != blank
      assign aps_note_parts = aps_top | split: ','
      assign aps_note_1 = aps_note_parts.first | strip
    elsif aps_main != blank
      assign aps_note_parts = aps_main | split: ','
      assign aps_note_1 = aps_note_parts.first | strip
    elsif aps_heart != blank
      assign aps_note_parts = aps_heart | split: ','
      assign aps_note_1 = aps_note_parts.first | strip
    endif

    if aps_heart != blank
      assign aps_note_parts = aps_heart | split: ','
      assign aps_note_2 = aps_note_parts.first | strip
    elsif aps_base != blank
      assign aps_note_parts = aps_base | split: ','
      assign aps_note_2 = aps_note_parts.first | strip
    elsif aps_main != blank
      assign aps_note_parts = aps_main | split: ','
      if aps_note_parts.size > 1
        assign aps_note_2 = aps_note_parts[1] | strip
      endif
    endif

    comment
      Priority 3 — generate only from real product fields (never invent notes)
    endcomment
    if aps_intro == blank
      if aps_note_1 != blank and aps_note_2 != blank and aps_note_1 != aps_note_2
        assign aps_intro = 'The quiet elegance of ' | append: aps_note_1 | append: ' wrapped in ' | append: aps_note_2 | append: '.'
      elsif aps_note_1 != blank
        assign aps_intro = 'A fragrance shaped around ' | append: aps_note_1 | append: ', distilled by hand for lasting presence.'
      elsif aps_nakshatra != blank
        assign aps_intro = 'A fragrance inspired by ' | append: aps_nakshatra | append: ' nakshatra — timeless Indian perfumery, distilled by hand.'
      elsif aps_zodiac != blank
        assign aps_intro = 'A fragrance inspired by ' | append: aps_zodiac | append: ', composed in the tradition of Indian attar craft.'
      elsif aps_planet != blank
        assign aps_intro = 'A fragrance inspired by ' | append: aps_planet | append: ' — sacred ritual energy translated into scent.'
      elsif aps_chakra != blank
        assign aps_intro = 'A fragrance inspired by ' | append: aps_chakra | append: ', composed for mindful ritual and quiet alignment.'
      elsif aps_mood != blank
        assign aps_intro = 'A handcrafted attar of ' | append: aps_p.title | append: ', composed for ' | append: aps_mood | append: '.'
      elsif aps_collection_title != blank
        assign aps_intro = 'A handcrafted fragrance from the ' | append: aps_collection_title | append: ' collection — ' | append: aps_p.title | append: '.'
      else
        assign aps_intro = 'A handcrafted attar of ' | append: aps_p.title | append: ', distilled in the tradition of Indian perfumery.'
      endif
    endif

    assign aps_all_notes = ''
    if aps_top != blank
      assign aps_all_notes = aps_top
    endif
    if aps_heart != blank
      if aps_all_notes != blank
        assign aps_all_notes = aps_all_notes | append: ', '
      endif
      assign aps_all_notes = aps_all_notes | append: aps_heart
    endif
    if aps_base != blank
      if aps_all_notes != blank
        assign aps_all_notes = aps_all_notes | append: ', '
      endif
      assign aps_all_notes = aps_all_notes | append: aps_base
    endif
    if aps_all_notes == blank and aps_main != blank
      assign aps_all_notes = aps_main
    endif

    if aps_all_notes != blank
      assign aps_body = aps_all_notes
    elsif aps_body == blank and aps_ingredients != blank
      assign aps_body = aps_ingredients
    endif
  -%}
  {%- endif -%}
  {%- endif -%}

  {%- if aps_intro != blank or aps_body != blank -%}
    {%- liquid
      if aps_intro != blank
        assign aps_intro = aps_intro | replace: ' 6ml', '' | replace: ' 6 ml', '' | strip
      endif
      if aps_body != blank
        assign aps_body = aps_body | replace: ' 6ml', '' | replace: ' 6 ml', '' | strip
      endif
    -%}
    {{ 'ar-product-description.css' | asset_url | stylesheet_tag }}
    <div class="anand-rasa-product-description" data-attar-story>
      {%- if aps_intro != blank -%}
        <div class="anand-rasa-product-description__main">
          <p>{{ aps_intro | replace: '&amp;', '&' | replace: '&#38;', '&' | escape }}</p>
        </div>
      {%- endif -%}

      {%- if aps_intro != blank and aps_body != blank -%}
        <div class="anand-rasa-product-description__divider" aria-hidden="true">
          <span class="anand-rasa-product-description__divider-icon">✦</span>
        </div>
      {%- endif -%}

      {%- if aps_body != blank -%}
        <div class="anand-rasa-product-description__sub">
          <p>{{ aps_body | replace: '&amp;', '&' | replace: '&#38;', '&' | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
{%- endif -%}
