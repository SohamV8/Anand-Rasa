            <th scope="col">Processing reason</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Data category">Contact and shipping details</td>
            <td data-label="Purpose">Fulfil orders, deliver products, communicate about your purchase</td>
            <td data-label="Processing reason">Provide the service you requested; order fulfilment</td>
          </tr>
          <tr>
            <td data-label="Data category">Transaction and order data</td>
            <td data-label="Purpose">Process payments, prevent fraud, manage returns/refunds, keep business records</td>
            <td data-label="Processing reason">Fulfilment and business/legal record-keeping needs</td>
          </tr>
          <tr>
            <td data-label="Data category">Account data</td>
            <td data-label="Purpose">Create and manage your customer account</td>
            <td data-label="Processing reason">Service you requested</td>
          </tr>
          <tr>
            <td data-label="Data category">Support messages</td>
            <td data-label="Purpose">Respond to enquiries and resolve issues</td>
            <td data-label="Processing reason">Service and customer care</td>
          </tr>
          <tr>
            <td data-label="Data category">Device and usage data</td>
            <td data-label="Purpose">Operate, secure, and improve the website</td>
            <td data-label="Processing reason">Site functionality and improvement</td>
          </tr>
          <tr>
            <td data-label="Data category">Analytics / advertising data</td>
            <td data-label="Purpose">Understand traffic, measure campaigns, show relevant ads where enabled</td>
            <td data-label="Processing reason">Consent where required; otherwise permitted marketing/measurement uses</td>
          </tr>
          <tr>
            <td data-label="Data category">Marketing preferences</td>
