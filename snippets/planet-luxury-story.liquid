      assign pls_b1_t = 'Courage & Action'
      assign pls_b1_d = 'Mangal is the planet of courage and determination. Great for people who want more energy, courage and drive to take action.'
      assign pls_b2_t = 'Bold, Long-Lasting Fragrance'
      assign pls_b2_d = 'Rich and long-lasting on skin. Alcohol-free and made with pure oils that slowly build into a strong, confident fragrance.'
      assign pls_b3_t = 'Inspired by Mars'
      assign pls_b3_d = 'Inspired by Mangal, the planet of courage and strength in Vedic astrology. Wear it when you need extra confidence and drive.'
      assign pls_b4_t = 'Saffron, Clove & Oud'
