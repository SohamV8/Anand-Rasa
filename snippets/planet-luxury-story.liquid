{%- if pls_product != blank and pls_key != blank and pls_image != blank -%}
  {%- liquid
    assign pls_collection_url = blank
    for pls_col in pls_product.collections
      assign pls_ch = pls_col.handle | downcase
      if pls_ch contains 'planet'
        assign pls_collection_url = pls_col.url
        break
      endif
    endfor
  -%}
  {%- if pls_collection_url == blank -%}
    {%- capture pls_collection_url -%}{% render 'ar-collection-url', handle: 'planet-attars' %}{%- endcapture -%}
    {%- assign pls_collection_url = pls_collection_url | strip -%}
  {%- endif -%}

  {%- liquid
    assign pls_img_src = pls_image | asset_url
    assign pls_alt = pls_product.title | append: ' bottle'
  -%}

  {{ 'planet-luxury-story.css' | asset_url | stylesheet_tag }}
  <style>
    @font-face {
      font-family: 'Reigo Black';
      src: url({{ 'Reigo-Black.ttf' | asset_url | json }}) format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
  </style>

  <section
    class="pls"
    id="pls-{{ pls_product.id }}"
    data-pls
    data-planet="{{ pls_key | escape }}"
    aria-label="{{ pls_heading | escape }}"
  >
    <div class="pls__grid" role="presentation">
      {%- if pls_b1_t != blank -%}
        <article class="pls__card pls__card--tl" data-pls-reveal>
          <h3 class="pls__card-title">{{ pls_b1_t | escape }}</h3>
          <p class="pls__card-text">{{ pls_b1_d | escape }}</p>
        </article>
      {%- endif -%}

      {%- if pls_b2_t != blank -%}
        <article class="pls__card pls__card--tr" data-pls-reveal>
          <h3 class="pls__card-title">{{ pls_b2_t | escape }}</h3>
          <p class="pls__card-text">{{ pls_b2_d | escape }}</p>
        </article>
      {%- endif -%}

      <div class="pls__stage" data-pls-reveal>
        <div class="pls__glow" aria-hidden="true"></div>
        <div class="pls__bottle-wrap">
          <img
            class="pls__bottle"
            src="{{ pls_img_src }}"
            alt="{{ pls_alt | escape }}"
            width="900"
            height="1125"
            loading="lazy"
            decoding="async"
          >
        </div>
      </div>

      {%- if pls_b3_t != blank -%}
        <article class="pls__card pls__card--bl" data-pls-reveal>
          <h3 class="pls__card-title">{{ pls_b3_t | escape }}</h3>
          <p class="pls__card-text">{{ pls_b3_d | escape }}</p>
        </article>
      {%- endif -%}

      {%- if pls_b4_t != blank -%}
        <article class="pls__card pls__card--br" data-pls-reveal>
          <h3 class="pls__card-title">{{ pls_b4_t | escape }}</h3>
          <p class="pls__card-text">{{ pls_b4_d | escape }}</p>
        </article>
      {%- endif -%}
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('pls-{{ pls_product.id }}');
      if (!root || root.dataset.plsBound === 'true') return;
      root.dataset.plsBound = 'true';

      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var nodes = root.querySelectorAll('[data-pls-reveal]');

      function showAll() {
        for (var i = 0; i < nodes.length; i++) nodes[i].classList.add('is-in');
      }

      if (reduce || !('IntersectionObserver' in window)) {
        showAll();
        return;
      }

      root.setAttribute('data-pls-ready', '');

      var io = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            entries[i].target.classList.add('is-in');
            io.unobserve(entries[i].target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
      );

      for (var j = 0; j < nodes.length; j++) io.observe(nodes[j]);

      /* Failsafe: never leave content invisible */
      window.setTimeout(showAll, 1800);
    })();
  </script>
{%- endif -%}
