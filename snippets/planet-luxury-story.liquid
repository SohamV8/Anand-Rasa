      assign pls_b4_t = 'Vetiver, Tulsi & Cardamom'
      assign pls_b4_d = 'Made with vetiver, tulsi, green cardamom and citrus. Fresh, natural ingredients chosen to match the clarity of Mercury.'
    when 'guru'
      assign pls_name = 'Guru Attar'
      assign pls_heading = 'Guru — The Attar of Wisdom'
      assign pls_desc = 'A warm, rich attar for wisdom, growth and guided decisions. Alcohol-free botanical oils that unfold slowly and linger.'
      assign pls_cta_primary = 'Discover Guru'
      assign pls_cta_secondary = 'Experience Jupiter Growth'
      assign pls_image = 'planet-attar-guru.webp'
      assign pls_icon = 'Planet-Jupiter.webp'
      assign pls_b1_t = 'Wisdom & Growth'
      assign pls_b1_d = 'Guru is the planet of wisdom and growth. Ideal for people who want good guidance, growth and success in life.'
      assign pls_b2_t = 'Rich, Long-Lasting Fragrance'
      assign pls_b2_d = 'Made with pure botanical oils. Alcohol-free and gentle on skin, with a rich fragrance that develops slowly over time.'
      assign pls_b3_t = 'Inspired by Jupiter'
      assign pls_b3_d = 'Inspired by Guru, the planet of wisdom and growth in Vedic astrology. Wear it during study, planning or important decisions.'
