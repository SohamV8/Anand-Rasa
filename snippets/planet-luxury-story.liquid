{%- comment -%}
  Premium luxury product story — planet attar PDPs only.
  Apple × Aesop × Byredo editorial layout under product info.

  Params:
    product {Product} required
    planet_key {String} optional — surya|chandra|mangal|budha|guru|shukra|shani|rahu|ketu
{%- endcomment -%}

{%- liquid
  assign pls_product = product
  if pls_product == blank
    assign pls_product = story_product
  endif

  assign pls_key = planet_key | default: '' | strip | downcase
  if pls_key == 'budh'
    assign pls_key = 'budha'
  elsif pls_key == 'sun'
    assign pls_key = 'surya'
  elsif pls_key == 'moon'
    assign pls_key = 'chandra'
  elsif pls_key == 'mars'
    assign pls_key = 'mangal'
  elsif pls_key == 'mercury'
    assign pls_key = 'budha'
  elsif pls_key == 'jupiter'
    assign pls_key = 'guru'
  elsif pls_key == 'venus'
    assign pls_key = 'shukra'
  elsif pls_key == 'saturn'
    assign pls_key = 'shani'
  endif

  if pls_key == blank and pls_product != blank
    assign pls_scope = pls_product.handle | append: '|' | append: pls_product.title | append: '|' | append: pls_product.type | downcase
    assign pls_tags = pls_product.tags | join: '|' | downcase
    assign pls_cols = pls_product.collections | map: 'handle' | join: '|' | downcase
    assign pls_all = pls_scope | append: '|' | append: pls_tags | append: '|' | append: pls_cols

    if pls_all contains 'surya' or pls_all contains 'sun-attar' or pls_all contains 'tejas' or pls_product.handle == 'sun-attar'
      assign pls_key = 'surya'
    elsif pls_all contains 'chandra' or pls_all contains 'moon-attar' or pls_all contains 'som rasa' or pls_product.handle == 'moon-attar'
      assign pls_key = 'chandra'
    elsif pls_all contains 'mangal' or pls_all contains 'mars-attar' or pls_all contains 'veer rasa' or pls_product.handle == 'mars-attar'
      assign pls_key = 'mangal'
    elsif pls_all contains 'budh' or pls_all contains 'mercury-attar' or pls_all contains 'vitpati' or pls_product.handle == 'mercury-attar'
      assign pls_key = 'budha'
    elsif pls_all contains 'guru' or pls_all contains 'jupiter-attar' or pls_all contains 'devguru' or pls_product.handle == 'jupiter-attar'
      assign pls_key = 'guru'
    elsif pls_all contains 'shukra' or pls_all contains 'venus-attar' or pls_all contains 'saundarya' or pls_product.handle == 'venus-attar'
      assign pls_key = 'shukra'
    elsif pls_all contains 'shani' or pls_all contains 'saturn-attar' or pls_all contains 'shaneshwar' or pls_product.handle == 'saturn-attar'
      assign pls_key = 'shani'
    elsif pls_all contains 'rahu' or pls_product.handle == 'rahu-attar'
      assign pls_key = 'rahu'
    elsif pls_all contains 'ketu' or pls_product.handle == 'ketu-attar'
      assign pls_key = 'ketu'
    endif
  endif

  assign pls_name = ''
  assign pls_heading = ''
  assign pls_desc = ''
  assign pls_cta_primary = 'Discover'
  assign pls_cta_secondary = 'Explore the Collection'
  assign pls_image = ''
  assign pls_icon = ''
  assign pls_b1_t = ''
  assign pls_b1_d = ''
  assign pls_b2_t = ''
  assign pls_b2_d = ''
  assign pls_b3_t = ''
  assign pls_b3_d = ''
  assign pls_b4_t = ''
  assign pls_b4_d = ''

  case pls_key
    when 'surya'
      assign pls_name = 'Surya Attar'
      assign pls_heading = 'Surya — The Solar Attar of Leadership'
      assign pls_desc = 'Crafted for confidence, leadership and everyday radiance. An alcohol-free solar attar that wears close to the skin and unfolds through the day.'
      assign pls_cta_primary = 'Discover Surya'
      assign pls_cta_secondary = 'Experience Solar Energy'
      assign pls_image = 'planet-attar-surya.webp'
      assign pls_icon = 'Planet-sun.webp'
      assign pls_b1_t = 'Confidence & Leadership'
      assign pls_b1_d = 'Surya is the planet of confidence, leadership and energy. Perfect for people who want to feel more confident and take charge in daily life.'
      assign pls_b2_t = 'Long-Lasting Fragrance'
      assign pls_b2_d = 'Made with pure botanical oils. Alcohol-free and gentle on skin. Slowly develops through the day for a rich, lasting fragrance.'
      assign pls_b3_t = 'Inspired by the Sun'
      assign pls_b3_d = 'Inspired by Surya, the planet of confidence and success in Vedic astrology. Wear it as part of your morning routine.'
      assign pls_b4_t = 'Saffron, Sandalwood & Amber'
      assign pls_b4_d = 'Made with saffron, Mysore sandalwood and warm amber. Simple, natural ingredients chosen to match the energy of the Sun.'
    when 'chandra'
      assign pls_name = 'Chandra Attar'
      assign pls_heading = 'Chandra — The Lunar Attar of Balance'
      assign pls_desc = 'A soft, skin-close attar for peace and emotional balance. Alcohol-free botanical oils that stay gentle through the evening.'
      assign pls_cta_primary = 'Discover Chandra'
      assign pls_cta_secondary = 'Experience Lunar Calm'
      assign pls_image = 'planet-attar-chandra.webp'
      assign pls_icon = 'Planet-moon.webp'
      assign pls_b1_t = 'Calm Mind & Balance'
      assign pls_b1_d = 'Chandra is the planet of peace and emotional balance. Ideal for anyone who wants a calmer mind and more balance in daily life.'
      assign pls_b2_t = 'Soft, Skin-Friendly Fragrance'
      assign pls_b2_d = 'Alcohol-free and made with pure botanical oils. Gentle on skin, with a soft fragrance that stays close all day.'
      assign pls_b3_t = 'Inspired by the Moon'
      assign pls_b3_d = 'Inspired by Chandra, the planet of calm and balance in Vedic astrology. Wear it during your evening routine to feel more relaxed.'
      assign pls_b4_t = 'Rose, Jasmine & Lotus'
      assign pls_b4_d = 'Made with white rose, jasmine and lotus. Soft, calming ingredients chosen to match the gentle nature of the Moon.'
    when 'mangal'
      assign pls_name = 'Mangal Attar'
      assign pls_heading = 'Mangal — The Attar of Courage'
      assign pls_desc = 'A bold, long-lasting attar for courage, drive and decisive action. Alcohol-free oils that build into a confident presence.'
      assign pls_cta_primary = 'Discover Mangal'
      assign pls_cta_secondary = 'Experience Martial Energy'
      assign pls_image = 'planet-attar-mangal.webp'
