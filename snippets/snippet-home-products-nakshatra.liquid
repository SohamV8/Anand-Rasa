{%- comment -%} 7. NAKSHATRA ATTAR {%- endcomment -%}
{%- capture ar_nakshatra_default_url -%}{% render 'ar-collection-url', handle: 'nakshatra-attars' %}{%- endcapture -%}
{%- liquid
  assign ar_nakshatra_url = section.settings.zh_url | strip
  if ar_nakshatra_url == blank or ar_nakshatra_url contains 'collections' or ar_nakshatra_url contains 'shopify://collections'
    assign ar_nakshatra_url = ar_nakshatra_default_url
  endif
-%}
<section class="ar-zh" style="background:#0F0F0F;">
  <div class="ar-zh__in">
    <div class="ar-zh__left">
      <h2 class="ar-zh__h">{{ section.settings.zh_heading | default: 'Nakshatra Attar for your soul.' }}</h2>
      <p class="ar-zh__p">{{ section.settings.zh_text | default: 'Twenty-seven Nakshatra attars crafted to mirror the mood and energy of each Vedic lunar mansion. Each attar is composed as a quiet, skin-close aura that echoes the symbolism, deity, and elemental nature of your birth star.' }}</p>
      <a href="{{ ar_nakshatra_url }}" class="ar-zh__btn">{{ section.settings.zh_btn | default: 'EXPLORE NAKSHATRA ATTARS' }}</a>
    </div>
    <div class="ar-zh__right">
      {%- comment -%}
        The clip is ~3MB of decorative animation below the fold. The poster paints
        the identical first frame for ~50KB, and lazy-video.js attaches the source
        and starts playback only once the section nears the viewport.
      {%- endcomment -%}
      <video
        class="ar-zh__media"
        style="width:88%;height:88%;inset:0;margin:auto;object-fit:contain;object-position:center center;"
        loop
        muted
        playsinline
        preload="none"
        poster="{{ 'NakshatraGif1-poster.webp' | asset_url }}"
        width="1536"
        height="1024"
        data-lazy-src="{{ 'NakshatraGif1.webm' | asset_url }}"
        data-lazy-type="video/webm"
        data-lazy-autoplay="true"
        aria-label="Nakshatra Attar animation"
      ></video>
    </div>
  </div>
</section>
<script src="{{ 'lazy-video.js' | asset_url }}" defer="defer"></script>
