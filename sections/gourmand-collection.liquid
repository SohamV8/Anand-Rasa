  }
  {%- if agm_col != blank and agm_col.products_count > 0 -%}
  ,"mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ agm_col.products_count }},
    "itemListElement": [
      {%- for product in agm_col.products limit: 12 -%}
        {
          "@type": "ListItem",
