<script>
(function () {
  'use strict';
  var root = document.getElementById('gourmand-{{ agm_id }}');
  if (!root || root.dataset.agmReady === 'true') return;
  root.dataset.agmReady = 'true';

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var nodes = root.querySelectorAll('[data-agm-reveal]');

  if (reduced || !('IntersectionObserver' in window)) {
    nodes.forEach(function (el) { el.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-in');
        io.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    nodes.forEach(function (el) { io.observe(el); });
  }

  root.querySelectorAll('.agm-faq__item').forEach(function (item) {
    var btn = item.querySelector('.agm-faq__trigger');
    var panel = item.querySelector('.agm-faq__panel');
    if (!btn || !panel) return;

    btn.addEventListener('click', function () {
      var open = item.classList.contains('is-open');
      var list = item.closest('.agm-faq__list');
      if (list) {
        list.querySelectorAll('.agm-faq__item.is-open').forEach(function (sib) {
          if (sib === item) return;
          sib.classList.remove('is-open');
          var sBtn = sib.querySelector('.agm-faq__trigger');
          var sPanel = sib.querySelector('.agm-faq__panel');
          if (sBtn) sBtn.setAttribute('aria-expanded', 'false');
          if (sPanel) sPanel.style.maxHeight = '0';
        });
      }
      if (open) {
        item.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        panel.style.maxHeight = '0';
      } else {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  });
})();
</script>

