{% comment %}
  Anand Rasa — Gourmand Collection Landing
  Hero + product grid only.
  Use with templates/collection.gourmand.json
{% endcomment %}

<style>
  @font-face {
    font-family: 'Reigo Black';
    src: url({{ 'Reigo-Black.ttf' | asset_url | json }}) format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>
{{ 'gourmand-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign agm_id = section.id
  assign agm_col = collection
  assign agm_heading = section.settings.heading | default: 'The Gourmand Collection'
  assign agm_sub = section.settings.subheading | default: 'Fragrances inspired by warm desserts, creamy woods, roasted coffee, vanilla, honey and timeless indulgence.'
  assign agm_per_page = section.settings.products_per_page | default: 12
  if agm_col != blank and agm_col.products_count > agm_per_page
    assign agm_per_page = agm_col.products_count
  endif
  assign agm_products_heading = section.settings.products_heading | default: 'Shop the Gourmand Collection'
  assign agm_seo_intro = section.settings.seo_intro | strip
-%}
<section
  id="gourmand-{{ agm_id }}"
  class="agm"
  aria-labelledby="agm-hero-title-{{ agm_id }}"
  data-agm-section
>
  {%- comment -%} ── Hero: centered copy + floating note cutouts ── {%- endcomment -%}
  <header class="agm-hero" data-agm-hero>
    <div class="agm-hero__floats" aria-hidden="true">
      <img
        class="agm-hero__float agm-hero__float--peach"
        src="{{ 'gourmand-float-peach.webp' | asset_url }}"
        alt=""
        width="325"
        height="299"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      >
      <img
        class="agm-hero__float agm-hero__float--mango"
        src="{{ 'gourmand-float-mango.webp' | asset_url }}"
        alt=""
        width="372"
        height="297"
        loading="eager"
        decoding="async"
      >
      <img
        class="agm-hero__float agm-hero__float--pineapple"
        src="{{ 'gourmand-float-pineapple.webp' | asset_url }}"
        alt=""
        width="379"
        height="305"
        loading="lazy"
        decoding="async"
      >
      <img
        class="agm-hero__float agm-hero__float--pear"
        src="{{ 'gourmand-float-pear.webp' | asset_url }}"
        alt=""
        width="329"
        height="327"
        loading="eager"
        decoding="async"
      >
      <img
        class="agm-hero__float agm-hero__float--raspberry"
        src="{{ 'gourmand-float-raspberry.webp' | asset_url }}"
        alt=""
        width="314"
        height="275"
        loading="lazy"
        decoding="async"
      >
      <img
        class="agm-hero__float agm-hero__float--vanilla"
        src="{{ 'gourmand-float-vanilla.webp' | asset_url }}"
        alt=""
        width="345"
        height="331"
        loading="eager"
        decoding="async"
      >
      <img
        class="agm-hero__float agm-hero__float--chocolate"
        src="{{ 'gourmand-float-chocolate.webp' | asset_url }}"
        alt=""
        width="320"
        height="245"
        loading="lazy"
        decoding="async"
      >
      <img
        class="agm-hero__float agm-hero__float--candy"
        src="{{ 'gourmand-float-candy.webp' | asset_url }}"
        alt=""
        width="340"
        height="284"
        loading="lazy"
        decoding="async"
      >
      <img
        class="agm-hero__float agm-hero__float--juniper"
        src="{{ 'gourmand-float-juniper.webp' | asset_url }}"
        alt=""
        width="394"
        height="378"
        loading="lazy"
        decoding="async"
      >
    </div>

    <div class="agm-hero__inner">
      <div class="agm-hero__copy">
        <span class="agm__eyebrow agm-hero__eyebrow" data-agm-reveal>{{ section.settings.eyebrow | default: 'Anand Rasa' }}</span>
        <h1 class="agm__title agm-hero__title" id="agm-hero-title-{{ agm_id }}" data-agm-reveal style="--agm-d:90ms;">
          {%- assign agm_title_lines = agm_heading | split: '|' -%}
          {%- if agm_title_lines.size > 1 -%}
            {%- for agm_line in agm_title_lines -%}
              <span class="agm-hero__line">{{ agm_line | strip | escape }}</span>
            {%- endfor -%}
          {%- elsif agm_heading == 'The Gourmand Collection' -%}
            <span class="agm-hero__line">The Gourmand</span>
            <span class="agm-hero__line">Collection</span>
          {%- else -%}
            <span class="agm-hero__line">{{ agm_heading | escape }}</span>
          {%- endif -%}
        </h1>
        <span class="agm__rule" aria-hidden="true" data-agm-reveal style="--agm-d:160ms;"></span>
        <p class="agm__lead agm-hero__lead" data-agm-reveal style="--agm-d:230ms;">{{ agm_sub | escape }}</p>
      </div>
    </div>
  </header>

  {%- if agm_seo_intro != blank -%}
    <div class="agm-seo-intro agm__wrap" data-agm-reveal>
      <p class="agm-seo-intro__text">{{ agm_seo_intro | escape | truncate: 320 }}</p>
    </div>
  {%- endif -%}

  {%- comment -%} ── Featured products ── {%- endcomment -%}
  <section class="agm-products" id="agm-products-{{ agm_id }}" aria-labelledby="agm-products-title-{{ agm_id }}">
    <div class="agm__wrap">
      <header class="agm-products__hdr" data-agm-reveal>
        <h2 class="agm__title" id="agm-products-title-{{ agm_id }}">{{ agm_products_heading | escape }}</h2>
        {%- if section.settings.products_lead != blank -%}
          <p class="agm-products__lead">{{ section.settings.products_lead | escape }}</p>
        {%- endif -%}
      </header>
      {%- if agm_col != blank and agm_col.products_count > 0 -%}
        <div class="agm-products__toolbar" data-agm-reveal>
          <p class="agm-products__count">{{ agm_col.products_count }} {{ agm_col.products_count | pluralize: 'fragrance', 'fragrances' }}</p>
        </div>
        <div class="agm-products__track-wrap">
          <ul
            class="agm-products__grid"
            role="list"
            aria-label="{{ agm_products_heading | escape }}"
          >
            {%- paginate agm_col.products by agm_per_page -%}
              {%- for product in agm_col.products -%}
                {%- liquid
                  assign agm_variant = product.selected_or_first_available_variant
                  assign agm_on_sale = false
                  if product.compare_at_price > product.price
                    assign agm_on_sale = true
                  endif
                  assign agm_badge = ''
                  if agm_variant.available == false
                    assign agm_badge = 'Sold out'
                  elsif product.tags contains 'bestseller' or product.tags contains 'Bestseller'
                    assign agm_badge = 'Bestseller'
                  elsif product.tags contains 'new' or product.tags contains 'New'
                    assign agm_badge = 'New'
                  elsif agm_on_sale
                    assign agm_badge = 'Sale'
                  endif
                  assign agm_img_alt = product.title
                  capture agm_img_alt
                    render 'image-seo-alt', seo_product: product, img_context: 'card'
                  endcapture
                  assign agm_img_alt = agm_img_alt | strip | default: product.title
                  assign agm_img_alt_hover = agm_img_alt
                  capture agm_img_alt_hover
                    render 'image-seo-alt', seo_product: product, img_context: 'hover'
                  endcapture
                  assign agm_img_alt_hover = agm_img_alt_hover | strip | default: agm_img_alt

                  assign agm_display_title = product.title | strip
                  if agm_display_title contains ' Attar'
                    assign agm_display_title = agm_display_title | replace: ' Attar', '' | strip
                  endif
                -%}
                <li data-agm-reveal style="--agm-d: {{ forloop.index0 | times: 45 }}ms;">
                  <article class="agm-card{% unless agm_variant.available %} agm-card--sold{% endunless %}">
                    <div class="agm-card__media-wrap">
                      <a href="{{ product.url }}" class="agm-card__media" aria-label="{{ product.title | escape }}">
                        {%- if product.featured_media -%}
                          <picture>
                            <source
                              type="image/webp"
                              srcset="{{ product.featured_media | image_url: width: 360, format: 'webp' }} 360w, {{ product.featured_media | image_url: width: 540, format: 'webp' }} 540w, {{ product.featured_media | image_url: width: 720, format: 'webp' }} 720w"
                              sizes="(max-width: 767px) 92vw, (max-width: 1100px) 30vw, 22vw"
                            >
                            {{
                              product.featured_media
                              | image_url: width: 720
                              | image_tag:
                                class: 'agm-card__img agm-card__img--primary',
                                loading: 'lazy',
                                widths: '360, 540, 720',
                                sizes: '(max-width: 767px) 92vw, (max-width: 1100px) 30vw, 22vw',
                                alt: agm_img_alt,
                                width: 720,
                                height: 900,
                                decoding: 'async'
                            }}
                          </picture>
                          {%- if product.media.size > 1 -%}
                            {%- for media in product.media offset: 1 limit: 4 -%}
                              {%- if media.media_type == 'image' -%}
                                {{
                                  media
                                  | image_url: width: 720
                                  | image_tag:
                                    class: 'agm-card__img agm-card__img--hover',
                                    loading: 'lazy',
                                    widths: '360, 540, 720',
                                    sizes: '(max-width: 767px) 92vw, (max-width: 1100px) 30vw, 22vw',
                                    alt: agm_img_alt_hover,
                                    width: 720,
                                    height: 900,
                                    decoding: 'async'
                                }}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'agm-card__img' }}
                        {%- endif -%}
                      </a>
                      {%- if agm_badge != blank -%}
                        <span class="agm-card__badge{% if agm_badge == 'Sale' %} agm-card__badge--sale{% elsif agm_badge == 'Sold out' %} agm-card__badge--sold{% endif %}">{{ agm_badge }}</span>
                      {%- endif -%}
                      <div class="agm-card__fade" aria-hidden="true"></div>
                    </div>

                    <div class="agm-card__glass">
                      <h3 class="agm-card__name">
                        <a href="{{ product.url }}">{{ agm_display_title }}</a>
                      </h3>
                      <div class="agm-card__meta" aria-label="Product details">
                        <span class="agm-card__chip">
                          {%- if agm_on_sale -%}
                            <span class="agm-card__compare">{{ product.compare_at_price | money }}</span>
                          {%- endif -%}
                          <span class="agm-card__price">{{ product.price | money }}</span>
                        </span>
                        <a href="{{ product.url }}" class="agm-card__chip agm-card__chip--link">View details</a>
                      </div>
                      <button
                        type="button"
                        class="agm-card__atc js-arc-atc"
                        data-id="{{ agm_variant.id }}"
                        aria-label="Add {{ product.title | escape }} to cart"
                        {% unless agm_variant.available %}disabled{% endunless %}
                      >
                        {%- if agm_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                      </button>
                    </div>
                  </article>
                </li>
              {%- endfor -%}
            {%- endpaginate -%}
          </ul>
        </div>
      {%- else -%}
        <div class="agm-empty" data-agm-reveal>
          <p>{{ section.settings.empty_text | default: 'Gourmand fragrances are being curated. Assign products to this collection in Shopify Admin, or explore our Perfume Series meanwhile.' }}</p>
          <p style="margin-top:20px;">
            <a href="{% render 'ar-collection-url', handle: 'perfume-series' %}" class="agm__btn">Explore Perfumes</a>
          </p>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- if section.settings.show_faq != false -%}
    {%- comment -%} ── Gourmand FAQ (built into this section for reliable theme upload) ── {%- endcomment -%}
    <section
      class="agm-faq"
      id="agm-faq-{{ agm_id }}"
      data-agm-faq
      aria-labelledby="agm-faq-title-{{ agm_id }}"
      itemscope
      itemtype="https://schema.org/FAQPage"
    >
      <div class="agm-faq__inner">
        <header class="agm-faq__hdr" data-agm-reveal>
          <h2 class="agm-faq__title" id="agm-faq-title-{{ agm_id }}">
            {{ section.settings.faq_heading | default: 'Frequently Asked Questions' }}
          </h2>
          <div class="agm-faq__ornament" aria-hidden="true">
            <span class="agm-faq__ornament-line"></span>
            <span class="agm-faq__ornament-dot"></span>
            <span class="agm-faq__ornament-line"></span>
          </div>
        </header>

        <ul class="agm-faq__list" role="list">
          {%- assign agm_faq_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' and block.settings.question != blank -%}
              {%- assign agm_faq_count = agm_faq_count | plus: 1 -%}
              {%- assign agm_faq_item_id = 'agm-faq-' | append: agm_id | append: '-' | append: block.id -%}
              <li
                class="agm-faq__item"
                style="--agm-d: {{ forloop.index0 | times: 45 }}ms;"
                data-agm-faq-item
                data-agm-reveal
                itemscope
                itemprop="mainEntity"
                itemtype="https://schema.org/Question"
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="agm-faq__trigger"
                  id="{{ agm_faq_item_id }}-btn"
                  aria-expanded="false"
                  aria-controls="{{ agm_faq_item_id }}-panel"
                >
                  <span class="agm-faq__q" itemprop="name">{{ block.settings.question | escape }}</span>
                  <span class="agm-faq__icon" aria-hidden="true"></span>
                </button>
                <div
                  class="agm-faq__panel"
                  id="{{ agm_faq_item_id }}-panel"
                  role="region"
                  aria-labelledby="{{ agm_faq_item_id }}-btn"
                >
                  <div class="agm-faq__panel-inner" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                    <p class="agm-faq__a" itemprop="text">{{ block.settings.answer | escape | newline_to_br }}</p>
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- if agm_faq_count == 0 -%}
            {%- liquid
              assign agm_faq_qs = 'What is a gourmand fragrance?|Are gourmand fragrances too sweet?|Are Anand Rasa gourmand oils alcohol-free?|How long do gourmand attars last on skin?|Are gourmand fragrances suitable for summer?|How should I wear a gourmand fragrance?' | split: '|'
              assign agm_faq_as = 'Gourmand fragrances draw from warm dessert and kitchen notes - vanilla, caramel, coffee, chocolate, honey, and toasted nuts - composed with the restraint of fine perfume rather than confection.|Not when crafted well. Anand Rasa gourmands favour roasted, creamy, and woody depth over candy-bright sweetness, so they feel intimate and elegant rather than sugary.|Yes. Our gourmand collection is formulated as alcohol-free perfume oils and attars - soft projection, skin-close warmth, and a lasting golden trail.|On skin, expect several hours of presence with a soft dry-down of sandalwood, amber, and musk. Longevity varies with skin type, climate, and how much you apply.|They shine in cooler weather and evenings, but lighter applications on pulse points can wear beautifully in warmer months without feeling heavy.|Apply a small amount to pulse points - wrists, neck, and behind the ears - or layer two oils for a personal signature. A little goes a long way with oil-based fragrances.' | split: '|'
            -%}
            {%- for q in agm_faq_qs -%}
              {%- assign agm_faq_item_id = 'agm-faq-' | append: agm_id | append: '-' | append: forloop.index -%}
              <li
                class="agm-faq__item"
                style="--agm-d: {{ forloop.index0 | times: 45 }}ms;"
                data-agm-faq-item
                data-agm-reveal
                itemscope
                itemprop="mainEntity"
                itemtype="https://schema.org/Question"
              >
                <button
                  type="button"
                  class="agm-faq__trigger"
                  id="{{ agm_faq_item_id }}-btn"
                  aria-expanded="false"
                  aria-controls="{{ agm_faq_item_id }}-panel"
                >
                  <span class="agm-faq__q" itemprop="name">{{ q | escape }}</span>
                  <span class="agm-faq__icon" aria-hidden="true"></span>
                </button>
                <div
                  class="agm-faq__panel"
                  id="{{ agm_faq_item_id }}-panel"
                  role="region"
                  aria-labelledby="{{ agm_faq_item_id }}-btn"
                >
                  <div class="agm-faq__panel-inner" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                    <p class="agm-faq__a" itemprop="text">{{ agm_faq_as[forloop.index0] | escape }}</p>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </section>
  {%- endif -%}
</section>

<script>
(function () {
  'use strict';
  var root = document.getElementById('gourmand-{{ agm_id }}');
  if (!root || root.dataset.agmReady === 'true') return;
  root.dataset.agmReady = 'true';

  var reduced = false;
  try {
    reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  } catch (e) {}

  var nodes = root.querySelectorAll('[data-agm-reveal]');
  var hero = root.querySelector('[data-agm-hero]');
  var revealed = false;

  function revealNodes() {
    if (revealed) return;
    revealed = true;
    for (var i = 0; i < nodes.length; i++) {
      nodes[i].classList.add('is-in');
    }
    root.classList.remove('is-animating');
  }

  function revealOne(el) {
    if (!el) return;
    el.classList.add('is-in');
  }

  /* Hero copy must never stay hidden — reveal immediately */
  if (hero) {
    var heroReveal = hero.querySelectorAll('[data-agm-reveal]');
    for (var h = 0; h < heroReveal.length; h++) {
      revealOne(heroReveal[h]);
    }
  }

  if (reduced) {
    if (hero) hero.classList.add('is-ready', 'is-bobbing');
    revealNodes();
  } else {
    root.classList.add('is-animating');

    if (hero) {
      requestAnimationFrame(function () {
        hero.classList.add('is-ready');
      });
      window.setTimeout(function () {
        hero.classList.add('is-bobbing');
      }, 900);
    }

    /* Hard failsafe: never leave content invisible */
    window.setTimeout(revealNodes, 600);

    if (!('IntersectionObserver' in window)) {
      revealNodes();
    } else {
      try {
        var io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            var entry = entries[i];
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
          var pending = root.querySelector('[data-agm-reveal]:not(.is-in)');
          if (!pending) {
            revealed = true;
            root.classList.remove('is-animating');
            io.disconnect();
          }
        }, { root: null, rootMargin: '80px 0px 80px 0px', threshold: 0.01 });

        for (var n = 0; n < nodes.length; n++) {
          if (nodes[n].classList.contains('is-in')) continue;
          io.observe(nodes[n]);
        }
      } catch (err) {
        revealNodes();
      }
    }
  }

  var faqItems = root.querySelectorAll('[data-agm-faq-item]');
  function setFaqOpen(item, open) {
    var btn = item.querySelector('.agm-faq__trigger');
    var panel = item.querySelector('.agm-faq__panel');
    if (!btn || !panel) return;
    item.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) panel.removeAttribute('inert');
    else panel.setAttribute('inert', '');
  }
  for (var f = 0; f < faqItems.length; f++) {
    (function (item) {
      var btn = item.querySelector('.agm-faq__trigger');
      var panel = item.querySelector('.agm-faq__panel');
      if (panel) panel.setAttribute('inert', '');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var willOpen = !item.classList.contains('is-open');
        for (var o = 0; o < faqItems.length; o++) {
          if (faqItems[o] !== item) setFaqOpen(faqItems[o], false);
        }
        setFaqOpen(item, willOpen);
      });
    })(faqItems[f]);
  }
})();
</script>

{% schema %}
{
  "name": "Gourmand Collection",
  "tag": "section",
  "class": "section section-gourmand-collection",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Anand Rasa" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gourmand Collection" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fragrances inspired by warm desserts, creamy woods, roasted coffee, vanilla, honey and timeless indulgence."
    },
    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "Shop the Gourmand Collection" },
    { "type": "textarea", "id": "products_lead", "label": "Products lead", "default": "Alcohol-free attars and perfume oils - edible warmth, wearable luxury." },
    { "type": "range", "id": "products_per_page", "min": 4, "max": 24, "step": 4, "label": "Products shown", "default": 12 },
    { "type": "textarea", "id": "empty_text", "label": "Empty state text" },
    { "type": "header", "content": "SEO" },
    {
      "type": "text",
      "id": "seo_title",
      "label": "SEO title",
      "info": "Overrides the default title tag when collection SEO metafields are empty. Keep under ~60 characters.",
      "default": "Gourmand Attars & Perfume Oils Online India | Anandrasa"
    },
    {
      "type": "textarea",
      "id": "seo_description",
      "label": "SEO meta description",
      "info": "Overrides the default meta description when collection SEO metafields are empty. Keep under ~155 characters.",
      "default": "Shop alcohol-free gourmand attars and perfume oils at Anandrasa. Warm vanilla, caramel, coffee, chocolate and honey scents — handcrafted edible fragrances from India."
    },
    {
      "type": "textarea",
      "id": "seo_intro",
      "label": "On-page SEO intro",
      "info": "Optional body copy under the hero. Leave blank to hide."
    },
    { "type": "header", "content": "FAQ" },
    { "type": "checkbox", "id": "show_faq", "label": "Show FAQ", "default": true },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Frequently Asked Questions" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is a gourmand fragrance?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Gourmand fragrances draw from warm dessert and kitchen notes - vanilla, caramel, coffee, chocolate, honey, and toasted nuts - composed with the restraint of fine perfume rather than confection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gourmand Collection",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What is a gourmand fragrance?",
            "answer": "Gourmand fragrances draw from warm dessert and kitchen notes - vanilla, caramel, coffee, chocolate, honey, and toasted nuts - composed with the restraint of fine perfume rather than confection."
          }
        },
        {
          "type": "faq",
