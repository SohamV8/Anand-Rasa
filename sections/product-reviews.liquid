{%- comment -%}
  Product reviews — paint Loox metafield HTML immediately, then let the
  widget take over if/when it hydrates. No delayed empty state.
{%- endcomment -%}

{%- if request.page_type == 'product' and product != blank -%}
  {{ 'ar-loox-reviews.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign ar_loox_reviews = product.metafields.loox.reviews
  -%}

  <section
    class="anand-rasa-reviews section section-product-reviews"
    aria-labelledby="anand-rasa-reviews-heading-{{ section.id }}"
  >
    <div class="anand-rasa-reviews__inner{% if section.settings.include_margins %} page-width{% endif %}">
      <h2 id="anand-rasa-reviews-heading-{{ section.id }}" class="anand-rasa-reviews__heading">
        Customer Reviews
      </h2>

      <div class="anand-rasa-reviews__widget">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div
            id="looxReviews"
            data-product-id="{{ product.id }}"
            class="loox-reviews-default{% if ar_loox_reviews != blank %} loox-reviews-default--ready{% endif %}"
          >
            {%- if ar_loox_reviews != blank -%}
              <div class="anand-rasa-reviews__ssr" id="anand-rasa-loox-ssr">
                {{ ar_loox_reviews }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var frameId = 'looxReviewsFrame';
      var ssrId = 'anand-rasa-loox-ssr';
      var rootId = 'looxReviews';

      function revealSsr() {
        var ssr = document.getElementById(ssrId);
        if (!ssr) return;
        var hidden = ssr.querySelector('#loox-inline-reviews, [style*="display:none"], [hidden]');
        if (hidden) {
          hidden.removeAttribute('hidden');
          hidden.style.display = '';
        }
      }

      function hideSsrWhenWidgetReady() {
        var frame = document.getElementById(frameId);
        var ssr = document.getElementById(ssrId);
        if (!frame || !ssr) return false;
        if ((frame.offsetHeight || 0) < 80) return false;
        ssr.hidden = true;
        return true;
      }

      revealSsr();

      window.addEventListener('message', function (event) {
        if (!event || !event.data) return;
        var data = event.data;
        if (typeof data === 'string' && data.charAt(0) === '{') {
          try { data = JSON.parse(data); } catch (e) { return; }
        }
        if (!data || data.type !== 'resize' || data.frame !== frameId) return;
        var frame = document.getElementById(frameId);
        if (!frame) return;
        var nextHeight = parseInt(data.height, 10);
        if (!nextHeight) return;
        frame.height = String(nextHeight);
        frame.style.height = nextHeight + 'px';
        hideSsrWhenWidgetReady();
      });

      if (!document.getElementById(ssrId)) return;

      var root = document.getElementById(rootId);
      if (!root || typeof MutationObserver !== 'function') return;

      var observer = new MutationObserver(function () {
        if (hideSsrWhenWidgetReady()) observer.disconnect();
      });
      observer.observe(root, { childList: true, subtree: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section section-product-reviews",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
